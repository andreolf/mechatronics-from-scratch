/span><span class=\"vlist-s\">​</span></span><span class=\"vlist-r\"><span class=\"vlist\" style=\"height:0.2861em;\"><span></span></span></span></span></span></span><span class=\"mopen\">[</span><span class=\"mord mathnormal\" style=\"margin-right:0.0315em;\">k</span><span class=\"mclose\">]</span><span class=\"mspace\" style=\"margin-right:0.2222em;\"></span><span class=\"mbin\">+</span><span class=\"mspace\" style=\"margin-right:0.2222em;\"></span></span><span class=\"katex-base\"><span class=\"katex-strut\" style=\"height:1.8em;vertical-align:-0.65em;\"></span><span class=\"mord\"><span class=\"mord mathnormal\" style=\"margin-right:0.0077em;\">R</span><span class=\"msupsub\"><span class=\"vlist-t vlist-t2\"><span class=\"vlist-r\"><span class=\"vlist\" style=\"height:0.3117em;\"><span style=\"top:-2.55em;margin-left:-0.0077em;margin-right:0.05em;\"><span class=\"pstrut\" style=\"height:2.7em;\"></span><span class=\"katex-sizing reset-size6 size3 mtight\"><span class=\"mord mathnormal mtight\" style=\"margin-right:0.0572em;\">j</span></span></span></span><span class=\"vlist-s\">​</span></span><span class=\"vlist-r\"><span class=\"vlist\" style=\"height:0.2861em;\"><span></span></span></span></span></span></span><span class=\"mspace\" style=\"margin-right:0.1667em;\"></span><span class=\"minner\"><span class=\"mopen delimcenter\" style=\"top:0em;\"><span class=\"delimsizing size2\">(</span></span><span class=\"mord\">1</span><span class=\"mspace\" style=\"margin-right:0.2222em;\"></span><span class=\"mbin\">−</span><span class=\"mspace\" style=\"margin-right:0.2222em;\"></span><span class=\"mord\"><span class=\"mord mathnormal\">e</span><span class=\"msupsub\"><span class=\"vlist-t\"><span class=\"vlist-r\"><span class=\"vlist\" style=\"height:0.938em;\"><span style=\"top:-3.113em;margin-right:0.05em;\"><span class=\"pstrut\" style=\"height:2.7em;\"></span><span class=\"katex-sizing reset-size6 size3 mtight\"><span class=\"mord mtight\"><span class=\"mord mtight\">−</span><span class=\"mord mtight\">Δ</span><span class=\"mord mathnormal mtight\">t</span><span class=\"mord mtight\">/</span><span class=\"mord mtight\"><span class=\"mord mathnormal mtight\" style=\"margin-right:0.1132em;\">τ</span><span class=\"msupsub\"><span class=\"vlist-t vlist-t2\"><span class=\"vlist-r\"><span class=\"vlist\" style=\"height:0.3281em;\"><span style=\"top:-2.357em;margin-left:-0.1132em;margin-right:0.0714em;\"><span class=\"pstrut\" style=\"height:2.5em;\"></span><span class=\"katex-sizing reset-size3 size1 mtight\"><span class=\"mord mathnormal mtight\" style=\"margin-right:0.0572em;\">j</span></span></span></span><span class=\"vlist-s\">​</span></span><span class=\"vlist-r\"><span class=\"vlist\" style=\"height:0.2819em;\"><span></span></span></span></span></span></span></span></span></span></span></span></span></span></span><span class=\"mclose delimcenter\" style=\"top:0em;\"><span class=\"delimsizing size2\">)</span></span></span><span class=\"mspace\" style=\"margin-right:0.1667em;\"></span><span class=\"mord mathnormal\">i</span><span class=\"mopen\">[</span><span class=\"mord mathnormal\" style=\"margin-right:0.0315em;\">k</span><span class=\"mclose\">]</span><span class=\"mpunct\">,</span></span></span></span></span></div>\n<p>with <span class=\"katex\"><span class=\"katex-html\" aria-hidden=\"true\"><span class=\"katex-base\"><span class=\"katex-strut\" style=\"height:0.7167em;vertical-align:-0.2861em;\"></span><span class=\"mord\"><span class=\"mord mathnormal\" style=\"margin-right:0.1132em;\">τ</span><span class=\"msupsub\"><span class=\"vlist-t vlist-t2\"><span class=\"vlist-r\"><span class=\"vlist\" style=\"height:0.3117em;\"><span style=\"top:-2.55em;margin-left:-0.1132em;margin-right:0.05em;\"><span class=\"pstrut\" style=\"height:2.7em;\"></span><span class=\"katex-sizing reset-size6 size3 mtight\"><span class=\"mord mathnormal mtight\" style=\"margin-right:0.0572em;\">j</span></span></span></span><span class=\"vlist-s\">​</span></span><span class=\"vlist-r\"><span class=\"vlist\" style=\"height:0.2861em;\"><span></span></span></span></span></span></span><span class=\"mspace\" style=\"margin-right:0.2778em;\"></span><span class=\"mrel\">=</span><span class=\"mspace\" style=\"margin-right:0.2778em;\"></span></span><span class=\"katex-base\"><span class=\"katex-strut\" style=\"height:0.9694em;vertical-align:-0.2861em;\"></span><span class=\"mord\"><span class=\"mord mathnormal\" style=\"margin-right:0.0077em;\">R</span><span class=\"msupsub\"><span class=\"vlist-t vlist-t2\"><span class=\"vlist-r\"><span class=\"vlist\" style=\"height:0.3117em;\"><span style=\"top:-2.55em;margin-left:-0.0077em;margin-right:0.05em;\"><span class=\"pstrut\" style=\"height:2.7em;\"></span><span class=\"katex-sizing reset-size6 size3 mtight\"><span class=\"mord mathnormal mtight\" style=\"margin-right:0.0572em;\">j</span></span></span></span><span class=\"vlist-s\">​</span></span><span class=\"vlist-r\"><span class=\"vlist\" style=\"height:0.2861em;\"><span></span></span></span></span></span></span><span class=\"mord\"><span class=\"mord mathnormal\" style=\"margin-right:0.0715em;\">C</span><span class=\"msupsub\"><span class=\"vlist-t vlist-t2\"><span class=\"vlist-r\"><span class=\"vlist\" style=\"height:0.3117em;\"><span style=\"top:-2.55em;margin-left:-0.0715em;margin-right:0.05em;\"><span class=\"pstrut\" style=\"height:2.7em;\"></span><span class=\"katex-sizing reset-size6 size3 mtight\"><span class=\"mord mathnormal mtight\" style=\"margin-right:0.0572em;\">j</span></span></span></span><span class=\"vlist-s\">​</span></span><span class=\"vlist-r\"><span class=\"vlist\" style=\"height:0.2861em;\"><span></span></span></span></span></span></span></span></span></span>. The update is exact for a current held constant over each step, so the model runs at any sample rate in a few multiplications: ideal for a battery management system microcontroller.</p>\n<h2 id=\"fitting-to-a-pulse-test\">Fitting to a pulse test</h2>\n<p>A <strong>pulse test</strong> applies current steps with rests between them and logs the voltage. <span class=\"katex\"><span class=\"katex-html\" aria-hidden=\"true\"><span class=\"katex-base\"><span class=\"katex-strut\" style=\"height:0.8333em;vertical-align:-0.15em;\"></span><span class=\"mord\"><span class=\"mord mathnormal\" style=\"margin-right:0.0077em;\">R</span><span class=\"msupsub\"><span class=\"vlist-t vlist-t2\"><span class=\"vlist-r\"><span class=\"vlist\" style=\"height:0.3011em;\"><span style=\"top:-2.55em;margin-left:-0.0077em;margin-right:0.05em;\"><span class=\"pstrut\" style=\"height:2.7em;\"></span><span class=\"katex-sizing reset-size6 size3 mtight\"><span class=\"mord mtight\">0</span></span></span></span><span class=\"vlist-s\">​</span></span><span class=\"vlist-r\"><span class=\"vlist\" style=\"height:0.15em;\"><span></span></span></span></span></span></span></span></span></span> is the instantaneous voltage step divided by the current step; the relaxation curves set the RC branches. Least squares fits all parameters at once by minimising the difference between simulated and measured voltage. Here the “measured” data come from a two-RC cell with 0.5 mV noise, so you can check what a one-RC fit misses. All parameter values are illustrative.</p>\n\n<figure class=\"fig\"><div class=\"fig-body\"><div class=\"widget\" data-widget=\"ecmfit\" data-args=\"{}\"></div></div><figcaption>A pulse test and the model’s response. Adjust R0, R1 and the time constant by hand and watch the error; the button jumps to the least-squares fit.</figcaption></figure>\n<h2 id=\"worked-example\">Worked example</h2>\n<p>Pulse test: 10 s rest, 30 s at 6 A, 60 s rest, 30 s at 3 A, 60 s rest, sampled at 10 Hz.</p>\n<ol>\n<li>Resistance only: peak error 91.8 mV, the relaxation is missing entirely.</li>\n<li>One RC branch: <span class=\"katex\"><span class=\"katex-html\" aria-hidden=\"true\"><span class=\"katex-base\"><span class=\"katex-strut\" style=\"height:0.8333em;vertical-align:-0.15em;\"></span><span class=\"mord\"><span class=\"mord mathnormal\" style=\"margin-right:0.0077em;\">R</span><span class=\"msupsub\"><span class=\"vlist-t vlist-t2\"><span class=\"vlist-r\"><span class=\"vlist\" style=\"height:0.3011em;\"><span style=\"top:-2.55em;margin-left:-0.0077em;margin-right:0.05em;\"><span class=\"pstrut\" style=\"height:2.7em;\"></span><span class=\"katex-sizing reset-size6 size3 mtight\"><span class=\"mord mtight\">0</span></span></span></span><span class=\"vlist-s\">​</span></span><span class=\"vlist-r\"><span class=\"vlist\" style=\"height:0.15em;\"><span></span></span></span></span></span></span><span class=\"mspace\" style=\"margin-right:0.2778em;\"></span><span class=\"mrel\">=</span><span class=\"mspace\" style=\"margin-right:0.2778em;\"></span></span><span class=\"katex-base\"><span class=\"katex-strut\" style=\"height:0.6444em;\"></span><span class=\"mord\">23.65</span></span></span></span> mΩ, <span class=\"katex\"><span class=\"katex-html\" aria-hidden=\"true\"><span class=\"katex-base\"><span class=\"katex-strut\" style=\"height:0.8333em;vertical-align:-0.15em;\"></span><span class=\"mord\"><span class=\"mord mathnormal\" style=\"margin-right:0.0077em;\">R</span><span class=\"msupsub\"><span class=\"vlist-t vlist-t2\"><span class=\"vlist-r\"><span class=\"vlist\" style=\"height:0.3011em;\"><span style=\"top:-2.55em;margin-left:-0.0077em;margin-right:0.05em;\"><span class=\"pstrut\" style=\"height:2.7em;\"></span><span class=\"katex-sizing reset-size6 size3 mtight\"><span class=\"mord mtight\">1</span></span></span></span><span class=\"vlist-s\">​</span></span><span class=\"vlist-r\"><span class=\"vlist\" style=\"height:0.15em;\"><span></span></span></span></span></span></span><span class=\"mspace\" style=\"margin-right:0.2778em;\"></span><span class=\"mrel\">=</span><span class=\"mspace\" style=\"margin-right:0.2778em;\"></span></span><span class=\"katex-base\"><span class=\"katex-strut\" style=\"height:0.6444em;\"></span><span class=\"mord\">17.08</span></span></span></span> mΩ, <span class=\"katex\"><span class=\"katex-html\" aria-hidden=\"true\"><span class=\"katex-base\"><span class=\"katex-strut\" style=\"height:0.8333em;vertical-align:-0.15em;\"></span><span class=\"mord\"><span class=\"mord mathnormal\" style=\"margin-right:0.0715em;\">C</span><span class=\"msupsub\"><span class=\"vlist-t vlist-t2\"><span class=\"vlist-r\"><span class=\"vlist\" style=\"height:0.3011em;\"><span style=\"top:-2.55em;margin-left:-0.0715em;margin-right:0.05em;\"><span class=\"pstrut\" style=\"height:2.7em;\"></span><span class=\"katex-sizing reset-size6 size3 mtight\"><span class=\"mord mtight\">1</span></span></span></span><span class=\"vlist-s\">​</span></span><span class=\"vlist-r\"><span class=\"vlist\" style=\"height:0.15em;\"><span></span></span></span></span></span></span><span class=\"mspace\" style=\"margin-right:0.2778em;\"></span><span class=\"mrel\">=</span><span class=\"mspace\" style=\"margin-right:0.2778em;\"></span></span><span class=\"katex-base\"><span class=\"katex-strut\" style=\"height:0.6444em;\"></span><span class=\"mord\">1014</span></span></span></span> F, <span class=\"katex\"><span class=\"katex-html\" aria-hidden=\"true\"><span class=\"katex-base\"><span class=\"katex-strut\" style=\"height:0.4306em;\"></span><span class=\"mord mathnormal\" style=\"margin-right:0.1132em;\">τ</span><span class=\"mspace\" style=\"margin-right:0.2778em;\"></span><span class=\"mrel\">=</span><span class=\"mspace\" style=\"margin-right:0.2778em;\"></span></span><span class=\"katex-base\"><span class=\"katex-strut\" style=\"height:0.6444em;\"></span><span class=\"mord\">17.3</span></span></span></span> s. RMS error 2.79 mV, peak 10.09 mV, under the 10 mV target on average.</li>\n<li>Two RC branches: <span class=\"katex\"><span class=\"katex-html\" aria-hidden=\"true\"><span class=\"katex-base\"><span class=\"katex-strut\" style=\"height:0.8333em;vertical-align:-0.15em;\"></span><span class=\"mord\"><span class=\"mord mathnormal\" style=\"margin-right:0.0077em;\">R</span><span class=\"msupsub\"><span class=\"vlist-t vlist-t2\"><span class=\"vlist-r\"><span class=\"vlist\" style=\"height:0.3011em;\"><span style=\"top:-2.55em;margin-left:-0.0077em;margin-right:0.05em;\"><span class=\"pstrut\" style=\"height:2.7em;\"></span><span class=\"katex-sizing reset-size6 size3 mtight\"><span class=\"mord mtight\">0</span></span></span></span><span class=\"vlist-s\">​</span></span><span class=\"vlist-r\"><span class=\"vlist\" style=\"height:0.15em;\"><span></span></span></span></span></span></span><span class=\"mspace\" style=\"margin-right:0.2778em;\"></span><span class=\"mrel\">=</span><span class=\"mspace\" style=\"margin-right:0.2778em;\"></span></span><span class=\"katex-base\"><span class=\"katex-strut\" style=\"height:0.6444em;\"></span><span class=\"mord\">22.00</span></span></span></span> mΩ, time constants 9.5 s and 47.1 s (truth 9.6 s and 48 s), RMS 0.50 mV, peak 1.92 mV: down to the noise.</li>\n<li><span class=\"katex\"><span class=\"katex-html\" aria-hidden=\"true\"><span class=\"katex-base\"><span class=\"katex-strut\" style=\"height:0.8333em;vertical-align:-0.15em;\"></span><span class=\"mord\"><span class=\"mord mathnormal\" style=\"margin-right:0.0077em;\">R</span><span class=\"msupsub\"><span class=\"vlist-t vlist-t2\"><span class=\"vlist-r\"><span class=\"vlist\" style=\"height:0.3011em;\"><span style=\"top:-2.55em;margin-left:-0.0077em;margin-right:0.05em;\"><span class=\"pstrut\" style=\"height:2.7em;\"></span><span class=\"katex-sizing reset-size6 size3 mtight\"><span class=\"mord mtight\">0</span></span></span></span><span class=\"vlist-s\">​</span></span><span class=\"vlist-r\"><span class=\"vlist\" style=\"height:0.15em;\"><span></span></span></span></span></span></span></span></span></span> from the instantaneous step alone: 22.08 mΩ against 22.00 mΩ.</li>\n</ol>\n<h2 id=\"code-it-from-scratch\">Code it from scratch</h2>\n\n<div class=\"code-card\" data-code=\"0\"><div class=\"code-head\"><span class=\"fname\" translate=\"no\">ecm.py</span><button class=\"btn btn-quiet btn-small\" type=\"button\" data-copy=\"0\">Copy</button><button class=\"btn btn-quiet btn-small\" type=\"button\" data-download=\"0\">Download</button></div><pre tabindex=\"0\"><code class=\"language-python\"><span class=\"hljs-keyword\">import</span> numpy <span class=\"hljs-keyword\">as</span> np\n<span class=\"hljs-keyword\">from</span> scipy.optimize <span class=\"hljs-keyword\">import</span> least_squares\n\n<span class=\"hljs-keyword\">def</span> <span class=\"hljs-title function_\">ocv</span>(<span class=\"hljs-params\">soc</span>): <span class=\"hljs-keyword\">return</span> <span class=\"hljs-number\">3.0</span> + <span class=\"hljs-number\">1.2</span> * soc - <span class=\"hljs-number\">0.25</span> * np.exp(-<span class=\"hljs-number\">12</span> * soc) + <span class=\"hljs-number\">0.05</span> * np.sin(<span class=\"hljs-number\">3</span> * soc)   <span class=\"hljs-comment\"># illustrative smooth curve</span>\n\n<span class=\"hljs-keyword\">def</span> <span class=\"hljs-title function_\">simulate</span>(<span class=\"hljs-params\">i, dt, q_ah, r0, rcs, soc0=<span class=\"hljs-number\">0.9</span></span>):\n    <span class=\"hljs-string\">&quot;&quot;&quot;Thevenin model: OCV(SOC) - i R0 - sum of RC branch voltages, each updated exactly for a step in current.&quot;&quot;&quot;</span>\n    soc = soc0; vs = np.zeros(<span class=\"hljs-built_in\">len</span>(rcs)); out = np.empty(<span class=\"hljs-built_in\">len</span>(i))\n    <span class=\"hljs-keyword\">for</span> k, ik <span class=\"hljs-keyword\">in</span> <span class=\"hljs-built_in\">enumerate</span>(i):\n        out[k] = ocv(soc) - ik * r0 - vs.<span class=\"hljs-built_in\">sum</span>()\n        <span class=\"hljs-keyword\">for</span> j, (r, c) <span class=\"hljs-keyword\">in</span> <span class=\"hljs-built_in\">enumerate</span>(rcs):\n            a = np.exp(-dt / (r * c)); vs[j] = a * vs[j] + r * (<span class=\"hljs-number\">1</span> - a) * ik\n        soc -= ik * dt / (q_ah * <span class=\"hljs-number\">3600</span>)\n    <span class=\"hljs-keyword\">return</span> out\n\n<span class=\"hljs-keyword\">def</span> <span class=\"hljs-title function_\">pulse_test</span>(<span class=\"hljs-params\">dt=<span class=\"hljs-number\">0.1</span></span>):\n    <span class=\"hljs-string\">&quot;&quot;&quot;10 s rest, 30 s at 6 A (2C), 60 s rest, 30 s at 3 A, 60 s rest.&quot;&quot;&quot;</span>\n    seg = [(<span class=\"hljs-number\">10</span>, <span class=\"hljs-number\">0</span>), (<span class=\"hljs-number\">30</span>, <span class=\"hljs-number\">6</span>), (<span class=\"hljs-number\">60</span>, <span class=\"hljs-number\">0</span>), (<span class=\"hljs-number\">30</span>, <span class=\"hljs-number\">3</span>), (<span class=\"hljs-number\">60</span>, <span class=\"hljs-number\">0</span>)]\n    <span class=\"hljs-keyword\">return</span> np.concatenate([np.full(<span class=\"hljs-built_in\">int</span>(t / dt), a, <span class=\"hljs-built_in\">float</span>) <span class=\"hljs-keyword\">for</span> t, a <span class=\"hljs-keyword\">in</span> seg])\n\n<span class=\"hljs-keyword\">def</span> <span class=\"hljs-title function_\">test_fit_one_rc</span>():\n    dt = <span class=\"hljs-number\">0.1</span>; q = <span class=\"hljs-number\">3.0</span>; i = pulse_test(dt); rng = np.random.default_rng(<span class=\"hljs-number\">1</span>)\n    truth = <span class=\"hljs-built_in\">dict</span>(r0=<span class=\"hljs-number\">0.022</span>, rcs=[(<span class=\"hljs-number\">0.012</span>, <span class=\"hljs-number\">800.0</span>), (<span class=\"hljs-number\">0.008</span>, <span class=\"hljs-number\">6000.0</span>)])           <span class=\"hljs-comment\"># &quot;real&quot; cell: two RC branches (illustrative)</span>\n    v = simulate(i, dt, q, **truth) + rng.normal(<span class=\"hljs-number\">0</span>, <span class=\"hljs-number\">0.5e-3</span>, <span class=\"hljs-built_in\">len</span>(i))          <span class=\"hljs-comment\"># measured with 0.5 mV noise</span>\n    <span class=\"hljs-keyword\">def</span> <span class=\"hljs-title function_\">resid</span>(<span class=\"hljs-params\">p</span>): <span class=\"hljs-keyword\">return</span> simulate(i, dt, q, p[<span class=\"hljs-number\">0</span>], [(p[<span class=\"hljs-number\">1</span>], p[<span class=\"hljs-number\">2</span>])]) - v\n    fit = least_squares(resid, [<span class=\"hljs-number\">0.01</span>, <span class=\"hljs-number\">0.01</span>, <span class=\"hljs-number\">1000.0</span>], bounds=([<span class=\"hljs-number\">0</span>, <span class=\"hljs-number\">0</span>, <span class=\"hljs-number\">1</span>], [<span class=\"hljs-number\">0.2</span>, <span class=\"hljs-number\">0.2</span>, <span class=\"hljs-number\">1e6</span>]), x_scale=[<span class=\"hljs-number\">0.01</span>, <span class=\"hljs-number\">0.01</span>, <span class=\"hljs-number\">1000</span>])\n    r0, r1, c1 = fit.x; err = resid(fit.x)\n    rms, peak = <span class=\"hljs-number\">1000</span> * np.sqrt(np.mean(err**<span class=\"hljs-number\">2</span>)), <span class=\"hljs-number\">1000</span> * np.<span class=\"hljs-built_in\">max</span>(np.<span class=\"hljs-built_in\">abs</span>(err))\n    <span class=\"hljs-built_in\">print</span>(<span class=\"hljs-string\">f&quot;1-RC fit: R0 <span class=\"hljs-subst\">{<span class=\"hljs-number\">1000</span> * r0:<span class=\"hljs-number\">.2</span>f}</span> mOhm, R1 <span class=\"hljs-subst\">{<span class=\"hljs-number\">1000</span> * r1:<span class=\"hljs-number\">.2</span>f}</span> mOhm, C1 <span class=\"hljs-subst\">{c1:<span class=\"hljs-number\">.0</span>f}</span> F, tau <span class=\"hljs-subst\">{r1 * c1:<span class=\"hljs-number\">.1</span>f}</span> s&quot;</span>)\n    <span class=\"hljs-built_in\">print</span>(<span class=\"hljs-string\">f&quot;error: rms <span class=\"hljs-subst\">{rms:<span class=\"hljs-number\">.2</span>f}</span> mV, peak <span class=\"hljs-subst\">{peak:<span class=\"hljs-number\">.2</span>f}</span> mV&quot;</span>)\n    d0 = simulate(i, dt, q, r0, []) - v                                      <span class=\"hljs-comment\"># resistance only, no RC branch</span>\n    <span class=\"hljs-built_in\">print</span>(<span class=\"hljs-string\">f&quot;R0-only model: peak error <span class=\"hljs-subst\">{<span class=\"hljs-number\">1000</span> * np.<span class=\"hljs-built_in\">max</span>(np.<span class=\"hljs-built_in\">abs</span>(d0)):<span class=\"hljs-number\">.1</span>f}</span> mV&quot;</span>)\n    <span class=\"hljs-keyword\">assert</span> rms &lt; <span class=\"hljs-number\">10</span> <span class=\"hljs-keyword\">and</span> np.<span class=\"hljs-built_in\">max</span>(np.<span class=\"hljs-built_in\">abs</span>(d0)) &gt; <span class=\"hljs-number\">0.05</span>\n    <span class=\"hljs-keyword\">def</span> <span class=\"hljs-title function_\">resid2</span>(<span class=\"hljs-params\">p</span>): <span class=\"hljs-keyword\">return</span> simulate(i, dt, q, p[<span class=\"hljs-number\">0</span>], [(p[<span class=\"hljs-number\">1</span>], p[<span class=\"hljs-number\">2</span>]), (p[<span class=\"hljs-number\">3</span>], p[<span class=\"hljs-number\">4</span>])]) - v\n    fit2 = least_squares(resid2, [<span class=\"hljs-number\">0.01</span>, <span class=\"hljs-number\">0.01</span>, <span class=\"hljs-number\">500.0</span>, <span class=\"hljs-number\">0.01</span>, <span class=\"hljs-number\">5000.0</span>], bounds=([<span class=\"hljs-number\">0</span>, <span class=\"hljs-number\">0</span>, <span class=\"hljs-number\">1</span>, <span class=\"hljs-number\">0</span>, <span class=\"hljs-number\">1</span>], [<span class=\"hljs-number\">0.2</span>, <span class=\"hljs-number\">0.2</span>, <span class=\"hljs-number\">1e6</span>, <span class=\"hljs-number\">0.2</span>, <span class=\"hljs-number\">1e6</span>]),\n                         x_scale=[<span class=\"hljs-number\">0.01</span>, <span class=\"hljs-number\">0.01</span>, <span class=\"hljs-number\">500</span>, <span class=\"hljs-number\">0.01</span>, <span class=\"hljs-number\">5000</span>])\n    e2 = resid2(fit2.x); taus = <span class=\"hljs-built_in\">sorted</span>([fit2.x[<span class=\"hljs-number\">1</span>] * fit2.x[<span class=\"hljs-number\">2</span>], fit2.x[<span class=\"hljs-number\">3</span>] * fit2.x[<span class=\"hljs-number\">4</span>]])\n    <span class=\"hljs-built_in\">print</span>(<span class=\"hljs-string\">f&quot;2-RC fit: R0 <span class=\"hljs-subst\">{<span class=\"hljs-number\">1000</span> * fit2.x[<span class=\"hljs-number\">0</span>]:<span class=\"hljs-number\">.2</span>f}</span> mOhm, tau <span class=\"hljs-subst\">{taus[<span class=\"hljs-number\">0</span>]:<span class=\"hljs-number\">.1</span>f}</span> s and <span class=\"hljs-subst\">{taus[<span class=\"hljs-number\">1</span>]:<span class=\"hljs-number\">.1</span>f}</span> s, rms <span class=\"hljs-subst\">{<span class=\"hljs-number\">1000</span> * np.sqrt(np.mean(e2**<span class=\"hljs-number\">2</span>)):<span class=\"hljs-number\">.2</span>f}</span> mV, peak <span class=\"hljs-subst\">{<span class=\"hljs-number\">1000</span> * np.<span class=\"hljs-built_in\">max</span>(np.<span class=\"hljs-built_in\">abs</span>(e2)):<span class=\"hljs-number\">.2</span>f}</span> mV&quot;</span>)\n    <span class=\"hljs-keyword\">assert</span> np.<span class=\"hljs-built_in\">max</span>(np.<span class=\"hljs-built_in\">abs</span>(e2)) &lt; <span class=\"hljs-number\">0.4</span> * peak / <span class=\"hljs-number\">1000</span>\n    r0_step = (v[<span class=\"hljs-built_in\">int</span>(<span class=\"hljs-number\">10</span> / dt) - <span class=\"hljs-number\">1</span>] - v[<span class=\"hljs-built_in\">int</span>(<span class=\"hljs-number\">10</span> / dt) + <span class=\"hljs-number\">0</span>]) / <span class=\"hljs-number\">6</span>                <span class=\"hljs-comment\"># instantaneous drop at the pulse edge</span>\n    <span class=\"hljs-built_in\">print</span>(<span class=\"hljs-string\">f&quot;R0 from the instantaneous step: <span class=\"hljs-subst\">{<span class=\"hljs-number\">1000</span> * r0_step:<span class=\"hljs-number\">.2</span>f}</span> mOhm (truth 22.00)&quot;</span>)\n    <span class=\"hljs-keyword\">assert</span> <span class=\"hljs-built_in\">abs</span>(r0_step - <span class=\"hljs-number\">0.022</span>) &lt; <span class=\"hljs-number\">0.002</span>\n\ntest_fit_one_rc()\n<span class=\"hljs-built_in\">print</span>(<span class=\"hljs-string\">&quot;PASS&quot;</span>)</code></pre></div>\n<h2 id=\"in-practice\">In practice</h2>\n<p>Battery teams fit ECM parameters as tables over SOC and temperature from pulse tests (the hybrid pulse power characterisation, HPPC, is the common procedure), with scipy or MATLAB. PyBaMM includes ECM models alongside its physics-based ones, and can generate synthetic pulse tests to practise on. Parameters drift as the cell ages, which is why many BMS designs re-estimate <span class=\"katex\"><span class=\"katex-html\" aria-hidden=\"true\"><span class=\"katex-base\"><span class=\"katex-strut\" style=\"height:0.8333em;vertical-align:-0.15em;\"></span><span class=\"mord\"><span class=\"mord mathnormal\" style=\"margin-right:0.0077em;\">R</span><span class=\"msupsub\"><span class=\"vlist-t vlist-t2\"><span class=\"vlist-r\"><span class=\"vlist\" style=\"height:0.3011em;\"><span style=\"top:-2.55em;margin-left:-0.0077em;margin-right:0.05em;\"><span class=\"pstrut\" style=\"height:2.7em;\"></span><span class=\"katex-sizing reset-size6 size3 mtight\"><span class=\"mord mtight\">0</span></span></span></span><span class=\"vlist-s\">​</span></span><span class=\"vlist-r\"><span class=\"vlist\" style=\"height:0.15em;\"><span></span></span></span></span></span></span></span></span></span> online.</p>\n<h2 id=\"exercises\">Exercises</h2>\n\n<div class=\"exercise\"><div class=\"ex-q\"><p>A 5 A step causes an instant 110 mV drop. What is <span class=\"katex\"><span class=\"katex-html\" aria-hidden=\"true\"><span class=\"katex-base\"><span class=\"katex-strut\" style=\"height:0.8333em;vertical-align:-0.15em;\"></span><span class=\"mord\"><span class=\"mord mathnormal\" style=\"margin-right:0.0077em;\">R</span><span class=\"msupsub\"><span class=\"vlist-t vlist-t2\"><span class=\"vlist-r\"><span class=\"vlist\" style=\"height:0.3011em;\"><span style=\"top:-2.55em;margin-left:-0.0077em;margin-right:0.05em;\"><span class=\"pstrut\" style=\"height:2.7em;\"></span><span class=\"katex-sizing reset-size6 size3 mtight\"><span class=\"mord mtight\">0</span></span></span></span><span class=\"vlist-s\">​</span></span><span class=\"vlist-r\"><span class=\"vlist\" style=\"height:0.15em;\"><span></span></span></span></span></span></span></span></span></span>?</p>\n</div><details><summary>Show the solution</summary><div class=\"ex-s\"><p><span class=\"katex\"><span class=\"katex-html\" aria-hidden=\"true\"><span class=\"katex-base\"><span class=\"katex-strut\" style=\"height:0.8333em;vertical-align:-0.15em;\"></span><span class=\"mord\"><span class=\"mord mathnormal\" style=\"margin-right:0.0077em;\">R</span><span class=\"msupsub\"><span class=\"vlist-t vlist-t2\"><span class=\"vlist-r\"><span class=\"vlist\" style=\"height:0.3011em;\"><span style=\"top:-2.55em;margin-left:-0.0077em;margin-right:0.05em;\"><span class=\"pstrut\" style=\"height:2.7em;\"></span><span class=\"katex-sizing reset-size6 size3 mtight\"><span class=\"mord mtight\">0</span></span></span></span><span class=\"vlist-s\">​</span></span><span class=\"vlist-r\"><span class=\"vlist\" style=\"height:0.15em;\"><span></span></span></span></span></span></span><span class=\"mspace\" style=\"margin-right:0.2778em;\"></span><span class=\"mrel\">=</span><span class=\"mspace\" style=\"margin-right:0.2778em;\"></span></span><span class=\"katex-base\"><span class=\"katex-strut\" style=\"height:1em;vertical-align:-0.25em;\"></span><span class=\"mord\">0.110/5</span><span class=\"mspace\" style=\"margin-right:0.2778em;\"></span><span class=\"mrel\">=</span><span class=\"mspace\" style=\"margin-right:0.2778em;\"></span></span><span class=\"katex-base\"><span class=\"katex-strut\" style=\"height:0.6444em;\"></span><span class=\"mord\">22</span></span></span></span> mΩ.</p>\n</div></details></div>\n\n<div class=\"exercise\"><div class=\"ex-q\"><p>Why does a one-RC fit leave a systematic error when the cell has two time constants?</p>\n</div><details><summary>Show the solution</summary><div class=\"ex-s\"><p>One exponential cannot match a relaxation that is the sum of a fast and a slow exponential. The fit compromises: too fast at the end of the rest, too slow at the start, giving a structured residual rather than noise.</p>\n</div></details></div>\n<h2 id=\"quiz\">Quiz</h2>\n\n<div class=\"quiz\" data-quiz=\"p19-l11\"></div>\n","toc":[{"id":"voltage-that-lags-current","title":"Voltage that lags current"},{"id":"the-thevenin-model","title":"The Thevenin model"},{"id":"fitting-to-a-pulse-test","title":"Fitting to a pulse test"},{"id":"worked-example","title":"Worked example"},{"id":"code-it-from-scratch","title":"Code it from scratch"},{"id":"in-practice","title":"In practice"},{"id":"exercises","title":"Exercises"},{"id":"quiz","title":"Quiz"}],"quiz":[{"id":"p19-l11-q1","type":"num","q":"<p>Time constant of R = 15 mΩ, C = 2000 F (s)?</p>\n","explain":"<p>τ = R C.</p>\n","answer":30,"tol":0.001,"unit":""},{"id":"p19-l11-q2","type":"num","q":"<p>Fraction of an RC branch’s final voltage reached after one time constant (%)?</p>\n","explain":"<p>1 − e⁻¹.</p>\n","answer":63.2,"tol":0.002,"unit":""},{"id":"p19-l11-q3","type":"num","q":"<p>Terminal voltage at OCV 3.8 V, 4 A, R0 20 mΩ and v1 30 mV (V)?</p>\n","explain":"<p>OCV − i R0 − v1.</p>\n","answer":3.69,"tol":0.002,"unit":""},{"id":"p19-l11-q4","type":"num","q":"<p>Discrete decay factor exp(−Δt/τ) for Δt 0.1 s and τ 20 s?</p>\n","explain":"<p>Close to 1 for fast sampling.</p>\n","answer":0.995,"tol":0.001,"unit":""},{"id":"p19-l11-q5","type":"mc","q":"<p>What sets R0 in a pulse test?</p>\n","explain":"<p>The ohmic part responds at once.</p>\n","options":["The capacity","The slowest time constant","The voltage after a long rest","The instantaneous voltage step divided by the current step"],"answer":3},{"id":"p19-l11-q6","type":"mc","q":"<p>Why do ECMs suit battery management systems?</p>\n","explain":"<p>Cheap and well-fitted.</p>\n","options":["They ignore SOC","They need no parameters","They run in a few multiplications per step and fit measured data","They model every chemical reaction"],"answer":2}],"code":[{"file":"ecm.py","lang":"python","src":"import numpy as np\nfrom scipy.optimize import least_squares\n\ndef ocv(soc): return 3.0 + 1.2 * soc - 0.25 * np.exp(-12 * soc) + 0.05 * np.sin(3 * soc)   # illustrative smooth curve\n\ndef simulate(i, dt, q_ah, r0, rcs, soc0=0.9):\n    \"\"\"Thevenin model: OCV(SOC) - i R0 - sum of RC branch voltages, each updated exactly for a step in current.\"\"\"\n    soc = soc0; vs = np.zeros(len(rcs)); out = np.empty(len(i))\n    for k, ik in enumerate(i):\n        out[k] = ocv(soc) - ik * r0 - vs.sum()\n        for j, (r, c) in enumerate(rcs):\n            a = np.exp(-dt / (r * c)); vs[j] = a * vs[j] + r * (1 - a) * ik\n        soc -= ik * dt / (q_ah * 3600)\n    return out\n\ndef pulse_test(dt=0.1):\n    \"\"\"10 s rest, 30 s at 6 A (2C), 60 s rest, 30 s at 3 A, 60 s rest.\"\"\"\n    seg = [(10, 0), (30, 6), (60, 0), (30, 3), (60, 0)]\n    return np.concatenate([np.full(int(t / dt), a, float) for t, a in seg])\n\ndef test_fit_one_rc():\n    dt = 0.1; q = 3.0; i = pulse_test(dt); rng = np.random.default_rng(1)\n    truth = dict(r0=0.022, rcs=[(0.012, 800.0), (0.008, 6000.0)])           # \"real\" cell: two RC branches (illustrative)\n    v = simulate(i, dt, q, **truth) + rng.normal(0, 0.5e-3, len(i))          # measured with 0.5 mV noise\n    def resid(p): return simulate(i, dt, q, p[0], [(p[1], p[2])]) - v\n    fit = least_squares(resid, [0.01, 0.01, 1000.0], bounds=([0, 0, 1], [0.2, 0.2, 1e6]), x_scale=[0.01, 0.01, 1000])\n    r0, r1, c1 = fit.x; err = resid(fit.x)\n    rms, peak = 1000 * np.sqrt(np.mean(err**2)), 1000 * np.max(np.abs(err))\n    print(f\"1-RC fit: R0 {1000 * r0:.2f} mOhm, R1 {1000 * r1:.2f} mOhm, C1 {c1:.0f} F, tau {r1 * c1:.1f} s\")\n    print(f\"error: rms {rms:.2f} mV, peak {peak:.2f} mV\")\n    d0 = simulate(i, dt, q, r0, []) - v                                      # resistance only, no RC branch\n    print(f\"R0-only model: peak error {1000 * np.max(np.abs(d0)):.1f} mV\")\n    assert rms < 10 and np.max(np.abs(d0)) > 0.05\n    def resid2(p): return simulate(i, dt, q, p[0], [(p[1], p[2]), (p[3], p[4])]) - v\n    fit2 = least_squares(resid2, [0.01, 0.01, 500.0, 0.01, 5000.0], bounds=([0, 0, 1, 0, 1], [0.2, 0.2, 1e6, 0.2, 1e6]),\n                         x_scale=[0.01, 0.01, 500, 0.01, 5000])\n    e2 = resid2(fit2.x); taus = sorted([fit2.x[1] * fit2.x[2], fit2.x[3] * fit2.x[4]])\n    print(f\"2-RC fit: R0 {1000 * fit2.x[0]:.2f} mOhm, tau {taus[0]:.1f} s and {taus[1]:.1f} s, rms {1000 * np.sqrt(np.mean(e2**2)):.2f} mV, peak {1000 * np.max(np.abs(e2)):.2f} mV\")\n    assert np.max(np.abs(e2)) < 0.4 * peak / 1000\n    r0_step = (v[int(10 / dt) - 1] - v[int(10 / dt) + 0]) / 6                # instantaneous drop at the pulse edge\n    print(f\"R0 from the instantaneous step: {1000 * r0_step:.2f} mOhm (truth 22.00)\")\n    assert abs(r0_step - 0.022) < 0.002\n\ntest_fit_one_rc()\nprint(\"PASS\")"}]}