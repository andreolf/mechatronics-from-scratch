figure>\n<h2 id=\"worked-example\">Worked example</h2>\n<p>Roll axis of the Lesson 07 quad, <span class=\"katex\"><span class=\"katex-html\" aria-hidden=\"true\"><span class=\"katex-base\"><span class=\"katex-strut\" style=\"height:0.8333em;vertical-align:-0.15em;\"></span><span class=\"mord\"><span class=\"mord mathnormal\" style=\"margin-right:0.0785em;\">I</span><span class=\"msupsub\"><span class=\"vlist-t vlist-t2\"><span class=\"vlist-r\"><span class=\"vlist\" style=\"height:0.1514em;\"><span style=\"top:-2.55em;margin-left:-0.0785em;margin-right:0.05em;\"><span class=\"pstrut\" style=\"height:2.7em;\"></span><span class=\"katex-sizing reset-size6 size3 mtight\"><span class=\"mord mtight\"><span class=\"mord mathnormal mtight\">xx</span></span></span></span></span><span class=\"vlist-s\">​</span></span><span class=\"vlist-r\"><span class=\"vlist\" style=\"height:0.15em;\"><span></span></span></span></span></span></span><span class=\"mspace\" style=\"margin-right:0.2778em;\"></span><span class=\"mrel\">=</span><span class=\"mspace\" style=\"margin-right:0.2778em;\"></span></span><span class=\"katex-base\"><span class=\"katex-strut\" style=\"height:0.6444em;\"></span><span class=\"mord\">0.012</span></span></span></span> kg·m², motor lag 20 ms, delay 6 ms, 500 Hz, torque limit 1.5 N·m; rate PID <span class=\"katex\"><span class=\"katex-html\" aria-hidden=\"true\"><span class=\"katex-base\"><span class=\"katex-strut\" style=\"height:0.9805em;vertical-align:-0.2861em;\"></span><span class=\"mord\"><span class=\"mord mathnormal\" style=\"margin-right:0.0315em;\">k</span><span class=\"msupsub\"><span class=\"vlist-t vlist-t2\"><span class=\"vlist-r\"><span class=\"vlist\" style=\"height:0.1514em;\"><span style=\"top:-2.55em;margin-left:-0.0315em;margin-right:0.05em;\"><span class=\"pstrut\" style=\"height:2.7em;\"></span><span class=\"katex-sizing reset-size6 size3 mtight\"><span class=\"mord mathnormal mtight\">p</span></span></span></span><span class=\"vlist-s\">​</span></span><span class=\"vlist-r\"><span class=\"vlist\" style=\"height:0.2861em;\"><span></span></span></span></span></span></span><span class=\"mspace\" style=\"margin-right:0.2778em;\"></span><span class=\"mrel\">=</span><span class=\"mspace\" style=\"margin-right:0.2778em;\"></span></span><span class=\"katex-base\"><span class=\"katex-strut\" style=\"height:0.6444em;\"></span><span class=\"mord\">0.36</span></span></span></span>, <span class=\"katex\"><span class=\"katex-html\" aria-hidden=\"true\"><span class=\"katex-base\"><span class=\"katex-strut\" style=\"height:0.8444em;vertical-align:-0.15em;\"></span><span class=\"mord\"><span class=\"mord mathnormal\" style=\"margin-right:0.0315em;\">k</span><span class=\"msupsub\"><span class=\"vlist-t vlist-t2\"><span class=\"vlist-r\"><span class=\"vlist\" style=\"height:0.3117em;\"><span style=\"top:-2.55em;margin-left:-0.0315em;margin-right:0.05em;\"><span class=\"pstrut\" style=\"height:2.7em;\"></span><span class=\"katex-sizing reset-size6 size3 mtight\"><span class=\"mord mathnormal mtight\">i</span></span></span></span><span class=\"vlist-s\">​</span></span><span class=\"vlist-r\"><span class=\"vlist\" style=\"height:0.15em;\"><span></span></span></span></span></span></span><span class=\"mspace\" style=\"margin-right:0.2778em;\"></span><span class=\"mrel\">=</span><span class=\"mspace\" style=\"margin-right:0.2778em;\"></span></span><span class=\"katex-base\"><span class=\"katex-strut\" style=\"height:0.6444em;\"></span><span class=\"mord\">1.0</span></span></span></span>, <span class=\"katex\"><span class=\"katex-html\" aria-hidden=\"true\"><span class=\"katex-base\"><span class=\"katex-strut\" style=\"height:0.8444em;vertical-align:-0.15em;\"></span><span class=\"mord\"><span class=\"mord mathnormal\" style=\"margin-right:0.0315em;\">k</span><span class=\"msupsub\"><span class=\"vlist-t vlist-t2\"><span class=\"vlist-r\"><span class=\"vlist\" style=\"height:0.3361em;\"><span style=\"top:-2.55em;margin-left:-0.0315em;margin-right:0.05em;\"><span class=\"pstrut\" style=\"height:2.7em;\"></span><span class=\"katex-sizing reset-size6 size3 mtight\"><span class=\"mord mathnormal mtight\">d</span></span></span></span><span class=\"vlist-s\">​</span></span><span class=\"vlist-r\"><span class=\"vlist\" style=\"height:0.15em;\"><span></span></span></span></span></span></span><span class=\"mspace\" style=\"margin-right:0.2778em;\"></span><span class=\"mrel\">=</span><span class=\"mspace\" style=\"margin-right:0.2778em;\"></span></span><span class=\"katex-base\"><span class=\"katex-strut\" style=\"height:0.6444em;\"></span><span class=\"mord\">0.004</span></span></span></span>; attitude <span class=\"katex\"><span class=\"katex-html\" aria-hidden=\"true\"><span class=\"katex-base\"><span class=\"katex-strut\" style=\"height:0.8444em;vertical-align:-0.15em;\"></span><span class=\"mord\"><span class=\"mord mathnormal\" style=\"margin-right:0.0315em;\">k</span><span class=\"msupsub\"><span class=\"vlist-t vlist-t2\"><span class=\"vlist-r\"><span class=\"vlist\" style=\"height:0.1514em;\"><span style=\"top:-2.55em;margin-left:-0.0315em;margin-right:0.05em;\"><span class=\"pstrut\" style=\"height:2.7em;\"></span><span class=\"katex-sizing reset-size6 size3 mtight\"><span class=\"mord mathnormal mtight\">a</span></span></span></span><span class=\"vlist-s\">​</span></span><span class=\"vlist-r\"><span class=\"vlist\" style=\"height:0.15em;\"><span></span></span></span></span></span></span><span class=\"mspace\" style=\"margin-right:0.2778em;\"></span><span class=\"mrel\">=</span><span class=\"mspace\" style=\"margin-right:0.2778em;\"></span></span><span class=\"katex-base\"><span class=\"katex-strut\" style=\"height:0.6444em;\"></span><span class=\"mord\">6</span></span></span></span>:</p>\n<ol>\n<li>Rate loop: crossover 27.8 rad/s, phase margin 62.4°, gain margin 17.1 dB, delay margin 39.1 ms.</li>\n<li>Attitude loop: crossover 6.54 rad/s, phase margin 78.6°, gain margin 20.0 dB; separation 4.3 times.</li>\n<li>A 20° roll step reaches 90 % in 321 ms with no overshoot (−0.2 %), is within 2 % after 655 ms, ends at 19.96°, and peaks at 0.567 N·m of torque, well inside the limit.</li>\n<li>Raising <span class=\"katex\"><span class=\"katex-html\" aria-hidden=\"true\"><span class=\"katex-base\"><span class=\"katex-strut\" style=\"height:0.8444em;vertical-align:-0.15em;\"></span><span class=\"mord\"><span class=\"mord mathnormal\" style=\"margin-right:0.0315em;\">k</span><span class=\"msupsub\"><span class=\"vlist-t vlist-t2\"><span class=\"vlist-r\"><span class=\"vlist\" style=\"height:0.1514em;\"><span style=\"top:-2.55em;margin-left:-0.0315em;margin-right:0.05em;\"><span class=\"pstrut\" style=\"height:2.7em;\"></span><span class=\"katex-sizing reset-size6 size3 mtight\"><span class=\"mord mathnormal mtight\">a</span></span></span></span><span class=\"vlist-s\">​</span></span><span class=\"vlist-r\"><span class=\"vlist\" style=\"height:0.15em;\"><span></span></span></span></span></span></span></span></span></span> to 25 moves the attitude crossover to 24.9 rad/s, next to the rate loop: phase margin drops to 37.3° and the step overshoots by 26.2 %.</li>\n</ol>\n<h2 id=\"code-it-from-scratch\">Code it from scratch</h2>\n\n<div class=\"code-card\" data-code=\"0\"><div class=\"code-head\"><span class=\"fname\" translate=\"no\">cascaded_control.py</span><button class=\"btn btn-quiet btn-small\" type=\"button\" data-copy=\"0\">Copy</button><button class=\"btn btn-quiet btn-small\" type=\"button\" data-download=\"0\">Download</button></div><pre tabindex=\"0\"><code class=\"language-python\"><span class=\"hljs-keyword\">import</span> numpy <span class=\"hljs-keyword\">as</span> np\n\nIxx, TAU_M, DELAY, T = <span class=\"hljs-number\">0.012</span>, <span class=\"hljs-number\">0.02</span>, <span class=\"hljs-number\">0.006</span>, <span class=\"hljs-number\">0.002</span>     <span class=\"hljs-comment\"># roll inertia, motor lag (s), sensing + compute delay (s), 500 Hz loop</span>\nTAU_MAX = <span class=\"hljs-number\">1.5</span>                                          <span class=\"hljs-comment\"># largest roll torque at hover (Lesson 07)</span>\nKP_R, KI_R, KD_R = <span class=\"hljs-number\">0.36</span>, <span class=\"hljs-number\">1.0</span>, <span class=\"hljs-number\">0.004</span>                    <span class=\"hljs-comment\"># rate loop PID, torque per rad/s of rate error</span>\nKP_A = <span class=\"hljs-number\">6.0</span>                                             <span class=\"hljs-comment\"># attitude loop P, rad/s of rate per rad of angle error</span>\n\n<span class=\"hljs-keyword\">def</span> <span class=\"hljs-title function_\">rate_controller</span>(<span class=\"hljs-params\">s</span>): <span class=\"hljs-keyword\">return</span> KP_R + KI_R / s + KD_R * s / (<span class=\"hljs-number\">1</span> + s / <span class=\"hljs-number\">200</span>)       <span class=\"hljs-comment\"># derivative filtered at 200 rad/s</span>\n<span class=\"hljs-keyword\">def</span> <span class=\"hljs-title function_\">actuator</span>(<span class=\"hljs-params\">s</span>): <span class=\"hljs-keyword\">return</span> np.exp(-DELAY * s) / (TAU_M * s + <span class=\"hljs-number\">1</span>)\n<span class=\"hljs-keyword\">def</span> <span class=\"hljs-title function_\">body</span>(<span class=\"hljs-params\">s</span>): <span class=\"hljs-keyword\">return</span> <span class=\"hljs-number\">1</span> / (Ixx * s)                     <span class=\"hljs-comment\"># torque -&gt; roll rate</span>\n\n<span class=\"hljs-keyword\">def</span> <span class=\"hljs-title function_\">L_inner</span>(<span class=\"hljs-params\">s</span>): <span class=\"hljs-keyword\">return</span> rate_controller(s) * actuator(s) * body(s)\n<span class=\"hljs-keyword\">def</span> <span class=\"hljs-title function_\">T_inner</span>(<span class=\"hljs-params\">s</span>): L = L_inner(s); <span class=\"hljs-keyword\">return</span> L / (<span class=\"hljs-number\">1</span> + L)\n<span class=\"hljs-keyword\">def</span> <span class=\"hljs-title function_\">L_outer</span>(<span class=\"hljs-params\">s</span>): <span class=\"hljs-keyword\">return</span> KP_A * T_inner(s) / s           <span class=\"hljs-comment\"># attitude error -&gt; rate setpoint -&gt; roll rate -&gt; angle</span>\n\n<span class=\"hljs-keyword\">def</span> <span class=\"hljs-title function_\">margins</span>(<span class=\"hljs-params\">L, w=np.logspace(<span class=\"hljs-params\">-<span class=\"hljs-number\">1</span>, <span class=\"hljs-number\">3.5</span>, <span class=\"hljs-number\">40000</span></span>)</span>):\n    Lw = L(<span class=\"hljs-number\">1j</span> * w); mag, ph = np.<span class=\"hljs-built_in\">abs</span>(Lw), np.unwrap(np.angle(Lw))\n    i = np.where(np.diff(np.sign(mag - <span class=\"hljs-number\">1</span>)))[<span class=\"hljs-number\">0</span>][<span class=\"hljs-number\">0</span>]; wc = w[i]; pm = <span class=\"hljs-number\">180</span> + np.degrees(ph[i])\n    j = np.where(np.diff(np.sign(ph + np.pi)))[<span class=\"hljs-number\">0</span>]; gm = -<span class=\"hljs-number\">20</span> * np.log10(mag[j[<span class=\"hljs-number\">0</span>]]) <span class=\"hljs-keyword\">if</span> <span class=\"hljs-built_in\">len</span>(j) <span class=\"hljs-keyword\">else</span> np.inf\n    <span class=\"hljs-keyword\">return</span> wc, pm, gm, np.radians(pm) / wc\n\n<span class=\"hljs-keyword\">def</span> <span class=\"hljs-title function_\">step</span>(<span class=\"hljs-params\">target_deg=<span class=\"hljs-number\">20</span>, t_end=<span class=\"hljs-number\">1.5</span>, dt=<span class=\"hljs-number\">1e-4</span></span>):\n    <span class=\"hljs-string\">&quot;&quot;&quot;time simulation with saturation and the delay as a buffer: roll step through both loops&quot;&quot;&quot;</span>\n    n_del = <span class=\"hljs-built_in\">int</span>(<span class=\"hljs-built_in\">round</span>(DELAY / dt)); buf = [<span class=\"hljs-number\">0.0</span>] * (n_del + <span class=\"hljs-number\">1</span>); phi = p = tau = integ = d_f = <span class=\"hljs-number\">0.0</span>; prev_e = <span class=\"hljs-number\">0.0</span>\n    u = <span class=\"hljs-number\">0.0</span>; log = []; sub = <span class=\"hljs-built_in\">int</span>(T / dt)\n    <span class=\"hljs-keyword\">for</span> k <span class=\"hljs-keyword\">in</span> <span class=\"hljs-built_in\">range</span>(<span class=\"hljs-built_in\">int</span>(t_end / dt)):\n        <span class=\"hljs-keyword\">if</span> k % sub == <span class=\"hljs-number\">0</span>:\n            p_ref = KP_A * (np.radians(target_deg) - phi)\n            e = p_ref - p; integ += e * T\n            d_f += T * <span class=\"hljs-number\">200</span> * ((e - prev_e) / T - d_f); prev_e = e\n            u_raw = KP_R * e + KI_R * integ + KD_R * d_f; u = np.clip(u_raw, -TAU_MAX, TAU_MAX)\n            <span class=\"hljs-keyword\">if</span> u != u_raw: integ -= e * T                <span class=\"hljs-comment\"># anti-windup: stop integrating while saturated</span>\n        buf.append(u); u_del = buf.pop(<span class=\"hljs-number\">0</span>)\n        tau += dt / TAU_M * (u_del - tau); p += dt * tau / Ixx; phi += dt * p\n        log.append((k * dt, np.degrees(phi), tau))\n    <span class=\"hljs-keyword\">return</span> np.array(log)\n\n<span class=\"hljs-keyword\">def</span> <span class=\"hljs-title function_\">test_loops</span>():\n    wi, pmi, gmi, dmi = margins(L_inner); wo, pmo, gmo, dmo = margins(L_outer)\n    <span class=\"hljs-built_in\">print</span>(<span class=\"hljs-string\">f&quot;rate loop: crossover <span class=\"hljs-subst\">{wi:<span class=\"hljs-number\">.1</span>f}</span> rad/s, phase margin <span class=\"hljs-subst\">{pmi:<span class=\"hljs-number\">.1</span>f}</span> deg, gain margin <span class=\"hljs-subst\">{gmi:<span class=\"hljs-number\">.1</span>f}</span> dB, delay margin <span class=\"hljs-subst\">{<span class=\"hljs-number\">1000</span> * dmi:<span class=\"hljs-number\">.1</span>f}</span> ms&quot;</span>)\n    <span class=\"hljs-built_in\">print</span>(<span class=\"hljs-string\">f&quot;attitude loop: crossover <span class=\"hljs-subst\">{wo:<span class=\"hljs-number\">.2</span>f}</span> rad/s, phase margin <span class=\"hljs-subst\">{pmo:<span class=\"hljs-number\">.1</span>f}</span> deg, gain margin <span class=\"hljs-subst\">{gmo:<span class=\"hljs-number\">.1</span>f}</span> dB, delay margin <span class=\"hljs-subst\">{<span class=\"hljs-number\">1000</span> * dmo:<span class=\"hljs-number\">.1</span>f}</span> ms&quot;</span>)\n    <span class=\"hljs-built_in\">print</span>(<span class=\"hljs-string\">f&quot;bandwidth separation: <span class=\"hljs-subst\">{wi / wo:<span class=\"hljs-number\">.1</span>f}</span>x&quot;</span>)\n    <span class=\"hljs-keyword\">assert</span> pmi &gt; <span class=\"hljs-number\">45</span> <span class=\"hljs-keyword\">and</span> gmi &gt; <span class=\"hljs-number\">6</span> <span class=\"hljs-keyword\">and</span> pmo &gt; <span class=\"hljs-number\">45</span> <span class=\"hljs-keyword\">and</span> gmo &gt; <span class=\"hljs-number\">6</span> <span class=\"hljs-keyword\">and</span> wi / wo &gt; <span class=\"hljs-number\">4</span>\n    log = step(); t, phi, tau = log.T; final = phi[-<span class=\"hljs-number\">1</span>]\n    over = <span class=\"hljs-number\">100</span> * (phi.<span class=\"hljs-built_in\">max</span>() - <span class=\"hljs-number\">20</span>) / <span class=\"hljs-number\">20</span>; t90 = t[np.argmax(phi &gt;= <span class=\"hljs-number\">18</span>)]\n    settle = t[np.where(np.<span class=\"hljs-built_in\">abs</span>(phi - <span class=\"hljs-number\">20</span>) &gt; <span class=\"hljs-number\">0.4</span>)[<span class=\"hljs-number\">0</span>][-<span class=\"hljs-number\">1</span>]]\n    <span class=\"hljs-built_in\">print</span>(<span class=\"hljs-string\">f&quot;20 deg step: rise to 90 % in <span class=\"hljs-subst\">{<span class=\"hljs-number\">1000</span> * t90:<span class=\"hljs-number\">.0</span>f}</span> ms, overshoot <span class=\"hljs-subst\">{over:<span class=\"hljs-number\">.1</span>f}</span> %, within 2 % after <span class=\"hljs-subst\">{<span class=\"hljs-number\">1000</span> * settle:<span class=\"hljs-number\">.0</span>f}</span> ms, &quot;</span>\n          <span class=\"hljs-string\">f&quot;final <span class=\"hljs-subst\">{final:<span class=\"hljs-number\">.2</span>f}</span> deg, peak torque <span class=\"hljs-subst\">{np.<span class=\"hljs-built_in\">abs</span>(tau).<span class=\"hljs-built_in\">max</span>():<span class=\"hljs-number\">.3</span>f}</span> N m&quot;</span>)\n    <span class=\"hljs-keyword\">assert</span> over &lt; <span class=\"hljs-number\">10</span> <span class=\"hljs-keyword\">and</span> <span class=\"hljs-built_in\">abs</span>(final - <span class=\"hljs-number\">20</span>) &lt; <span class=\"hljs-number\">0.2</span> <span class=\"hljs-keyword\">and</span> np.<span class=\"hljs-built_in\">abs</span>(tau).<span class=\"hljs-built_in\">max</span>() &lt;= TAU_MAX + <span class=\"hljs-number\">1e-9</span>\n\n<span class=\"hljs-keyword\">def</span> <span class=\"hljs-title function_\">test_bad_tuning</span>():\n    <span class=\"hljs-keyword\">global</span> KP_A\n    keep = KP_A; KP_A = <span class=\"hljs-number\">25.0</span>                            <span class=\"hljs-comment\"># outer loop too close to the inner loop</span>\n    wo, pmo, gmo, _ = margins(L_outer); log = step(); over = <span class=\"hljs-number\">100</span> * (log[:, <span class=\"hljs-number\">1</span>].<span class=\"hljs-built_in\">max</span>() - <span class=\"hljs-number\">20</span>) / <span class=\"hljs-number\">20</span>\n    <span class=\"hljs-built_in\">print</span>(<span class=\"hljs-string\">f&quot;attitude P 25: crossover <span class=\"hljs-subst\">{wo:<span class=\"hljs-number\">.1</span>f}</span> rad/s, phase margin <span class=\"hljs-subst\">{pmo:<span class=\"hljs-number\">.1</span>f}</span> deg, overshoot <span class=\"hljs-subst\">{over:<span class=\"hljs-number\">.1</span>f}</span> %&quot;</span>)\n    <span class=\"hljs-keyword\">assert</span> pmo &lt; <span class=\"hljs-number\">45</span> <span class=\"hljs-keyword\">and</span> over &gt; <span class=\"hljs-number\">10</span>\n    KP_A = keep\n\ntest_loops(); test_bad_tuning(); <span class=\"hljs-built_in\">print</span>(<span class=\"hljs-string\">&quot;PASS&quot;</span>)</code></pre></div>\n<h2 id=\"in-practice\">In practice</h2>\n<p>PX4 uses exactly this structure: <code>MC_ROLLRATE_P/I/D</code> for the rate loop and <code>MC_ROLL_P</code> for the attitude loop, tuned from the inside out. Its autotuner identifies the plant and sets the rate gains, and flight logs give step responses to check against margins like these. Try the step on the site’s <a href=\"#lab-quad\">live quadcopter lab</a>.</p>\n<h2 id=\"exercises\">Exercises</h2>\n\n<div class=\"exercise\"><div class=\"ex-q\"><p>Why tune the rate loop first?</p>\n</div><details><summary>Show the solution</summary><div class=\"ex-s\"><p>The attitude loop’s plant is the closed rate loop. If the rate loop changes, the outer loop’s margins change with it; tuning from the inside out keeps each step well defined.</p>\n</div></details></div>\n\n<div class=\"exercise\"><div class=\"ex-q\"><p>A 0.2 N·m gust lasts long. What steady roll error does the cascade hold before the integrator acts?</p>\n</div><details><summary>Show the solution</summary><div class=\"ex-s\"><p>The stiffness is <span class=\"katex\"><span class=\"katex-html\" aria-hidden=\"true\"><span class=\"katex-base\"><span class=\"katex-strut\" style=\"height:0.9805em;vertical-align:-0.2861em;\"></span><span class=\"mord\"><span class=\"mord mathnormal\" style=\"margin-right:0.0315em;\">k</span><span class=\"msupsub\"><span class=\"vlist-t vlist-t2\"><span class=\"vlist-r\"><span class=\"vlist\" style=\"height:0.1514em;\"><span style=\"top:-2.55em;margin-left:-0.0315em;margin-right:0.05em;\"><span class=\"pstrut\" style=\"height:2.7em;\"></span><span class=\"katex-sizing reset-size6 size3 mtight\"><span class=\"mord mathnormal mtight\">a</span></span></span></span><span class=\"vlist-s\">​</span></span><span class=\"vlist-r\"><span class=\"vlist\" style=\"height:0.15em;\"><span></span></span></span></span></span></span><span class=\"mord\"><span class=\"mord mathnormal\" style=\"margin-right:0.0315em;\">k</span><span class=\"msupsub\"><span class=\"vlist-t vlist-t2\"><span class=\"vlist-r\"><span class=\"vlist\" style=\"height:0.1514em;\"><span style=\"top:-2.55em;margin-left:-0.0315em;margin-right:0.05em;\"><span class=\"pstrut\" style=\"height:2.7em;\"></span><span class=\"katex-sizing reset-size6 size3 mtight\"><span class=\"mord mathnormal mtight\">p</span></span></span></span><span class=\"vlist-s\">​</span></span><span class=\"vlist-r\"><span class=\"vlist\" style=\"height:0.2861em;\"><span></span></span></span></span></span></span><span class=\"mspace\" style=\"margin-right:0.2778em;\"></span><span class=\"mrel\">=</span><span class=\"mspace\" style=\"margin-right:0.2778em;\"></span></span><span class=\"katex-base\"><span class=\"katex-strut\" style=\"height:0.7278em;vertical-align:-0.0833em;\"></span><span class=\"mord\">6</span><span class=\"mspace\" style=\"margin-right:0.2222em;\"></span><span class=\"mbin\">×</span><span class=\"mspace\" style=\"margin-right:0.2222em;\"></span></span><span class=\"katex-base\"><span class=\"katex-strut\" style=\"height:0.6444em;\"></span><span class=\"mord\">0.36</span><span class=\"mspace\" style=\"margin-right:0.2778em;\"></span><span class=\"mrel\">=</span><span class=\"mspace\" style=\"margin-right:0.2778em;\"></span></span><span class=\"katex-base\"><span class=\"katex-strut\" style=\"height:0.6444em;\"></span><span class=\"mord\">2.16</span></span></span></span> N·m/rad, so <span class=\"katex\"><span class=\"katex-html\" aria-hidden=\"true\"><span class=\"katex-base\"><span class=\"katex-strut\" style=\"height:1em;vertical-align:-0.25em;\"></span><span class=\"mord\">0.2/2.16</span><span class=\"mspace\" style=\"margin-right:0.2778em;\"></span><span class=\"mrel\">=</span><span class=\"mspace\" style=\"margin-right:0.2778em;\"></span></span><span class=\"katex-base\"><span class=\"katex-strut\" style=\"height:0.6444em;\"></span><span class=\"mord\">0.093</span></span></span></span> rad, 5.3°. The rate integrator then slowly removes it.</p>\n</div></details></div>\n<h2 id=\"quiz\">Quiz</h2>\n\n<div class=\"quiz\" data-quiz=\"p20-l09\"></div>\n","toc":[{"id":"two-loops-two-speeds","title":"Two loops, two speeds"},{"id":"worked-example","title":"Worked example"},{"id":"code-it-from-scratch","title":"Code it from scratch"},{"id":"in-practice","title":"In practice"},{"id":"exercises","title":"Exercises"},{"id":"quiz","title":"Quiz"}],"quiz":[{"id":"p20-l09-q1","type":"num","q":"<p>Bandwidth separation of 27.8 and 6.54 rad/s?</p>\n","explain":"<p>Ratio of crossovers.</p>\n","answer":4.25,"tol":0.005,"unit":""},{"id":"p20-l09-q2","type":"num","q":"<p>Delay margin for 62.4° at 27.8 rad/s (ms)?</p>\n","explain":"<p>φm/ωc.</p>\n","answer":39.2,"tol":0.005,"unit":""},{"id":"p20-l09-q3","type":"num","q":"<p>Phase lag of a 20 ms motor at 27.8 rad/s (degrees)?</p>\n","explain":"<p>atan(ωτ).</p>\n","answer":29.08,"tol":0.005,"unit":""},{"id":"p20-l09-q4","type":"num","q":"<p>Phase lag of a 6 ms delay at 27.8 rad/s (degrees)?</p>\n","explain":"<p>ωTd in degrees.</p>\n","answer":9.56,"tol":0.005,"unit":""},{"id":"p20-l09-q5","type":"mc","q":"<p>What happens when the attitude crossover approaches the rate crossover?</p>\n","explain":"<p>The inner loop’s lag is no longer negligible.</p>\n","options":["The rate loop becomes unstable","Nothing, the loops are independent","The drone becomes slower","The outer phase margin falls and the step overshoots"],"answer":3},{"id":"p20-l09-q6","type":"mc","q":"<p>Why does the inner loop control rate rather than angle?</p>\n","explain":"<p>The fastest, cleanest signal goes in the inner loop.</p>\n","options":["The mixer needs rates","Angles cannot be measured","Rate loops need no tuning","The gyro measures rate directly with little lag and noise"],"answer":3}],"code":[{"file":"cascaded_control.py","lang":"python","src":"import numpy as np\n\nIxx, TAU_M, DELAY, T = 0.012, 0.02, 0.006, 0.002     # roll inertia, motor lag (s), sensing + compute delay (s), 500 Hz loop\nTAU_MAX = 1.5                                          # largest roll torque at hover (Lesson 07)\nKP_R, KI_R, KD_R = 0.36, 1.0, 0.004                    # rate loop PID, torque per rad/s of rate error\nKP_A = 6.0                                             # attitude loop P, rad/s of rate per rad of angle error\n\ndef rate_controller(s): return KP_R + KI_R / s + KD_R * s / (1 + s / 200)       # derivative filtered at 200 rad/s\ndef actuator(s): return np.exp(-DELAY * s) / (TAU_M * s + 1)\ndef body(s): return 1 / (Ixx * s)                     # torque -> roll rate\n\ndef L_inner(s): return rate_controller(s) * actuator(s) * body(s)\ndef T_inner(s): L = L_inner(s); return L / (1 + L)\ndef L_outer(s): return KP_A * T_inner(s) / s           # attitude error -> rate setpoint -> roll rate -> angle\n\ndef margins(L, w=np.logspace(-1, 3.5, 40000)):\n    Lw = L(1j * w); mag, ph = np.abs(Lw), np.unwrap(np.angle(Lw))\n    i = np.where(np.diff(np.sign(mag - 1)))[0][0]; wc = w[i]; pm = 180 + np.degrees(ph[i])\n    j = np.where(np.diff(np.sign(ph + np.pi)))[0]; gm = -20 * np.log10(mag[j[0]]) if len(j) else np.inf\n    return wc, pm, gm, np.radians(pm) / wc\n\ndef step(target_deg=20, t_end=1.5, dt=1e-4):\n    \"\"\"time simulation with saturation and the delay as a buffer: roll step through both loops\"\"\"\n    n_del = int(round(DELAY / dt)); buf = [0.0] * (n_del + 1); phi = p = tau = integ = d_f = 0.0; prev_e = 0.0\n    u = 0.0; log = []; sub = int(T / dt)\n    for k in range(int(t_end / dt)):\n        if k % sub == 0:\n            p_ref = KP_A * (np.radians(target_deg) - phi)\n            e = p_ref - p; integ += e * T\n            d_f += T * 200 * ((e - prev_e) / T - d_f); prev_e = e\n            u_raw = KP_R * e + KI_R * integ + KD_R * d_f; u = np.clip(u_raw, -TAU_MAX, TAU_MAX)\n            if u != u_raw: integ -= e * T                # anti-windup: stop integrating while saturated\n        buf.append(u); u_del = buf.pop(0)\n        tau += dt / TAU_M * (u_del - tau); p += dt * tau / Ixx; phi += dt * p\n        log.append((k * dt, np.degrees(phi), tau))\n    return np.array(log)\n\ndef test_loops():\n    wi, pmi, gmi, dmi = margins(L_inner); wo, pmo, gmo, dmo = margins(L_outer)\n    print(f\"rate loop: crossover {wi:.1f} rad/s, phase margin {pmi:.1f} deg, gain margin {gmi:.1f} dB, delay margin {1000 * dmi:.1f} ms\")\n    print(f\"attitude loop: crossover {wo:.2f} rad/s, phase margin {pmo:.1f} deg, gain margin {gmo:.1f} dB, delay margin {1000 * dmo:.1f} ms\")\n    print(f\"bandwidth separation: {wi / wo:.1f}x\")\n    assert pmi > 45 and gmi > 6 and pmo > 45 and gmo > 6 and wi / wo > 4\n    log = step(); t, phi, tau = log.T; final = phi[-1]\n    over = 100 * (phi.max() - 20) / 20; t90 = t[np.argmax(phi >= 18)]\n    settle = t[np.where(np.abs(phi - 20) > 0.4)[0][-1]]\n    print(f\"20 deg step: rise to 90 % in {1000 * t90:.0f} ms, overshoot {over:.1f} %, within 2 % after {1000 * settle:.0f} ms, \"\n          f\"final {final:.2f} deg, peak torque {np.abs(tau).max():.3f} N m\")\n    assert over < 10 and abs(final - 20) < 0.2 and np.abs(tau).max() <= TAU_MAX + 1e-9\n\ndef test_bad_tuning():\n    global KP_A\n    keep = KP_A; KP_A = 25.0                            # outer loop too close to the inner loop\n    wo, pmo, gmo, _ = margins(L_outer); log = step(); over = 100 * (log[:, 1].max() - 20) / 20\n    print(f\"attitude P 25: crossover {wo:.1f} rad/s, phase margin {pmo:.1f} deg, overshoot {over:.1f} %\")\n    assert pmo < 45 and over > 10\n    KP_A = keep\n\ntest_loops(); test_bad_tuning(); print(\"PASS\")"}]}