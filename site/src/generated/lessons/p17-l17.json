" style=\"height:0.2806em;\"><span style=\"top:-2.55em;margin-left:0em;margin-right:0.05em;\"><span class=\"pstrut\" style=\"height:2.7em;\"></span><span class=\"katex-sizing reset-size6 size3 mtight\"><span class=\"mord mathnormal mtight\">t</span></span></span></span><span class=\"vlist-s\">​</span></span><span class=\"vlist-r\"><span class=\"vlist\" style=\"height:0.15em;\"><span></span></span></span></span></span></span><span class=\"mclose\">)</span></span></span><span style=\"top:-3.23em;\"><span class=\"pstrut\" style=\"height:3em;\"></span><span class=\"frac-line\" style=\"border-bottom-width:0.04em;\"></span></span><span style=\"top:-3.677em;\"><span class=\"pstrut\" style=\"height:3em;\"></span><span class=\"mord\"><span class=\"mord mathnormal\">p</span><span class=\"mopen\">(</span><span class=\"mord\"><span class=\"mord mathnormal\">m</span><span class=\"msupsub\"><span class=\"vlist-t vlist-t2\"><span class=\"vlist-r\"><span class=\"vlist\" style=\"height:0.3117em;\"><span style=\"top:-2.55em;margin-left:0em;margin-right:0.05em;\"><span class=\"pstrut\" style=\"height:2.7em;\"></span><span class=\"katex-sizing reset-size6 size3 mtight\"><span class=\"mord mathnormal mtight\">i</span></span></span></span><span class=\"vlist-s\">​</span></span><span class=\"vlist-r\"><span class=\"vlist\" style=\"height:0.15em;\"><span></span></span></span></span></span></span><span class=\"mspace\" style=\"margin-right:0.2778em;\"></span><span class=\"mrel\">∣</span><span class=\"mspace\" style=\"margin-right:0.2778em;\"></span><span class=\"mord\"><span class=\"mord mathnormal\" style=\"margin-right:0.044em;\">z</span><span class=\"msupsub\"><span class=\"vlist-t vlist-t2\"><span class=\"vlist-r\"><span class=\"vlist\" style=\"height:0.2806em;\"><span style=\"top:-2.55em;margin-left:-0.044em;margin-right:0.05em;\"><span class=\"pstrut\" style=\"height:2.7em;\"></span><span class=\"katex-sizing reset-size6 size3 mtight\"><span class=\"mord mathnormal mtight\">t</span></span></span></span><span class=\"vlist-s\">​</span></span><span class=\"vlist-r\"><span class=\"vlist\" style=\"height:0.15em;\"><span></span></span></span></span></span></span><span class=\"mpunct\">,</span><span class=\"mspace\" style=\"margin-right:0.1667em;\"></span><span class=\"mord\"><span class=\"mord mathnormal\">x</span><span class=\"msupsub\"><span class=\"vlist-t vlist-t2\"><span class=\"vlist-r\"><span class=\"vlist\" style=\"height:0.2806em;\"><span style=\"top:-2.55em;margin-left:0em;margin-right:0.05em;\"><span class=\"pstrut\" style=\"height:2.7em;\"></span><span class=\"katex-sizing reset-size6 size3 mtight\"><span class=\"mord mathnormal mtight\">t</span></span></span></span><span class=\"vlist-s\">​</span></span><span class=\"vlist-r\"><span class=\"vlist\" style=\"height:0.15em;\"><span></span></span></span></span></span></span><span class=\"mclose\">)</span></span></span></span><span class=\"vlist-s\">​</span></span><span class=\"vlist-r\"><span class=\"vlist\" style=\"height:0.936em;\"><span></span></span></span></span></span><span class=\"mclose nulldelimiter\"></span></span></span></span></span><span class=\"vlist-s\">​</span></span><span class=\"vlist-r\"><span class=\"vlist\" style=\"height:1.584em;\"><span></span></span></span></span></span></span></span><span class=\"vlist-s\">​</span></span><span class=\"vlist-r\"><span class=\"vlist\" style=\"height:2.2701em;\"><span></span></span></span></span></span><span class=\"mspace\" style=\"margin-right:0.2222em;\"></span><span class=\"mbin\">−</span><span class=\"mspace\" style=\"margin-right:0.2222em;\"></span></span><span class=\"katex-base\"><span class=\"katex-strut\" style=\"height:0.8444em;vertical-align:-0.15em;\"></span><span class=\"mord\"><span class=\"mord\">ℓ</span><span class=\"msupsub\"><span class=\"vlist-t vlist-t2\"><span class=\"vlist-r\"><span class=\"vlist\" style=\"height:0.3011em;\"><span style=\"top:-2.55em;margin-left:0em;margin-right:0.05em;\"><span class=\"pstrut\" style=\"height:2.7em;\"></span><span class=\"katex-sizing reset-size6 size3 mtight\"><span class=\"mord mtight\">0</span></span></span></span><span class=\"vlist-s\">​</span></span><span class=\"vlist-r\"><span class=\"vlist\" style=\"height:0.15em;\"><span></span></span></span></span></span></span><span class=\"mord\">.</span></span></span></span></span></div>\n<p>Each observation <strong>adds</strong> a constant: here <span class=\"katex\"><span class=\"katex-html\" aria-hidden=\"true\"><span class=\"katex-base\"><span class=\"katex-strut\" style=\"height:0.7278em;vertical-align:-0.0833em;\"></span><span class=\"mord\">+</span><span class=\"mord\">0.85</span></span></span></span> for a beam ending in the cell (hit), <span class=\"katex\"><span class=\"katex-html\" aria-hidden=\"true\"><span class=\"katex-base\"><span class=\"katex-strut\" style=\"height:0.7278em;vertical-align:-0.0833em;\"></span><span class=\"mord\">−</span><span class=\"mord\">0.4</span></span></span></span> for a beam passing through it (free). With prior <span class=\"katex\"><span class=\"katex-html\" aria-hidden=\"true\"><span class=\"katex-base\"><span class=\"katex-strut\" style=\"height:0.8444em;vertical-align:-0.15em;\"></span><span class=\"mord\"><span class=\"mord\">ℓ</span><span class=\"msupsub\"><span class=\"vlist-t vlist-t2\"><span class=\"vlist-r\"><span class=\"vlist\" style=\"height:0.3011em;\"><span style=\"top:-2.55em;margin-left:0em;margin-right:0.05em;\"><span class=\"pstrut\" style=\"height:2.7em;\"></span><span class=\"katex-sizing reset-size6 size3 mtight\"><span class=\"mord mtight\">0</span></span></span></span><span class=\"vlist-s\">​</span></span><span class=\"vlist-r\"><span class=\"vlist\" style=\"height:0.15em;\"><span></span></span></span></span></span></span><span class=\"mspace\" style=\"margin-right:0.2778em;\"></span><span class=\"mrel\">=</span><span class=\"mspace\" style=\"margin-right:0.2778em;\"></span></span><span class=\"katex-base\"><span class=\"katex-strut\" style=\"height:0.6444em;\"></span><span class=\"mord\">0</span></span></span></span> (<span class=\"katex\"><span class=\"katex-html\" aria-hidden=\"true\"><span class=\"katex-base\"><span class=\"katex-strut\" style=\"height:0.625em;vertical-align:-0.1944em;\"></span><span class=\"mord mathnormal\">p</span><span class=\"mspace\" style=\"margin-right:0.2778em;\"></span><span class=\"mrel\">=</span><span class=\"mspace\" style=\"margin-right:0.2778em;\"></span></span><span class=\"katex-base\"><span class=\"katex-strut\" style=\"height:0.6444em;\"></span><span class=\"mord\">0.5</span></span></span></span>, unknown), <span class=\"katex\"><span class=\"katex-html\" aria-hidden=\"true\"><span class=\"katex-base\"><span class=\"katex-strut\" style=\"height:0.625em;vertical-align:-0.1944em;\"></span><span class=\"mord mathnormal\">p</span><span class=\"mspace\" style=\"margin-right:0.2778em;\"></span><span class=\"mrel\">=</span><span class=\"mspace\" style=\"margin-right:0.2778em;\"></span></span><span class=\"katex-base\"><span class=\"katex-strut\" style=\"height:0.7278em;vertical-align:-0.0833em;\"></span><span class=\"mord\">1</span><span class=\"mspace\" style=\"margin-right:0.2222em;\"></span><span class=\"mbin\">−</span><span class=\"mspace\" style=\"margin-right:0.2222em;\"></span></span><span class=\"katex-base\"><span class=\"katex-strut\" style=\"height:1em;vertical-align:-0.25em;\"></span><span class=\"mord\">1/</span><span class=\"mopen\">(</span><span class=\"mord\">1</span><span class=\"mspace\" style=\"margin-right:0.2222em;\"></span><span class=\"mbin\">+</span><span class=\"mspace\" style=\"margin-right:0.2222em;\"></span></span><span class=\"katex-base\"><span class=\"katex-strut\" style=\"height:1.0991em;vertical-align:-0.25em;\"></span><span class=\"mord\"><span class=\"mord mathnormal\">e</span><span class=\"msupsub\"><span class=\"vlist-t\"><span class=\"vlist-r\"><span class=\"vlist\" style=\"height:0.8491em;\"><span style=\"top:-3.063em;margin-right:0.05em;\"><span class=\"pstrut\" style=\"height:2.7em;\"></span><span class=\"katex-sizing reset-size6 size3 mtight\"><span class=\"mord mtight\">ℓ</span></span></span></span></span></span></span></span><span class=\"mclose\">)</span></span></span></span>. <strong>Clamping</strong> <span class=\"katex\"><span class=\"katex-html\" aria-hidden=\"true\"><span class=\"katex-base\"><span class=\"katex-strut\" style=\"height:0.6944em;\"></span><span class=\"mord\">ℓ</span></span></span></span> to <span class=\"katex\"><span class=\"katex-html\" aria-hidden=\"true\"><span class=\"katex-base\"><span class=\"katex-strut\" style=\"height:1em;vertical-align:-0.25em;\"></span><span class=\"mopen\">[</span><span class=\"mord\">−</span><span class=\"mord\">4</span><span class=\"mpunct\">,</span><span class=\"mspace\" style=\"margin-right:0.1667em;\"></span><span class=\"mord\">4</span><span class=\"mclose\">]</span></span></span></span> keeps the map able to change when a door opens or a chair moves.</p>\n<h2 id=\"tracing-the-beams\">Tracing the beams</h2>\n<p>For each beam, the cells between the sensor and the end point are free and the end cell is occupied (if the beam hit something within range). <strong>Bresenham’s line algorithm</strong> lists those cells with integer additions only. A beam that returns maximum range marks only free cells.</p>\n<h2 id=\"what-the-map-gets-wrong\">What the map gets wrong</h2>\n<p>Range noise and the cell size blur wall surfaces: a beam that ends a few centimetres short marks a wall cell as free, one that ends long marks the cell behind. Errors therefore concentrate within a cell or two of surfaces. The free-space evidence also outweighs hits on thin obstacles seen at grazing angles, which is why the hit increment is larger than the free one.</p>\n\n<figure class=\"fig\"><div class=\"fig-body\"><div class=\"widget\" data-widget=\"occgrid\" data-args=\"{}\"></div></div><figcaption>An illustrative room mapped from laser scans along a known path. Add scans one by one and watch unknown grey cells turn free (dark) or occupied (bright).</figcaption></figure>\n<h2 id=\"worked-example\">Worked example</h2>\n<p>An illustrative 8 × 5 m area at 5 cm cells (160 × 100) with outer walls, a pillar and two wall stubs; 180 beams per scan every 2°, 2 cm range noise; scans along a known S-shaped path. A cell counts as observed when <span class=\"katex\"><span class=\"katex-html\" aria-hidden=\"true\"><span class=\"katex-base\"><span class=\"katex-strut\" style=\"height:1em;vertical-align:-0.25em;\"></span><span class=\"mord\">∣</span><span class=\"mord\">ℓ</span><span class=\"mord\">∣</span><span class=\"mspace\" style=\"margin-right:0.2778em;\"></span><span class=\"mrel\">&gt;</span><span class=\"mspace\" style=\"margin-right:0.2778em;\"></span></span><span class=\"katex-base\"><span class=\"katex-strut\" style=\"height:0.6444em;\"></span><span class=\"mord\">0.5</span></span></span></span>.</p>\n<ol>\n<li>Three hits on a cell: <span class=\"katex\"><span class=\"katex-html\" aria-hidden=\"true\"><span class=\"katex-base\"><span class=\"katex-strut\" style=\"height:0.6944em;\"></span><span class=\"mord\">ℓ</span><span class=\"mspace\" style=\"margin-right:0.2778em;\"></span><span class=\"mrel\">=</span><span class=\"mspace\" style=\"margin-right:0.2778em;\"></span></span><span class=\"katex-base\"><span class=\"katex-strut\" style=\"height:0.6444em;\"></span><span class=\"mord\">2.55</span></span></span></span>, <span class=\"katex\"><span class=\"katex-html\" aria-hidden=\"true\"><span class=\"katex-base\"><span class=\"katex-strut\" style=\"height:0.625em;vertical-align:-0.1944em;\"></span><span class=\"mord mathnormal\">p</span><span class=\"mspace\" style=\"margin-right:0.2778em;\"></span><span class=\"mrel\">=</span><span class=\"mspace\" style=\"margin-right:0.2778em;\"></span></span><span class=\"katex-base\"><span class=\"katex-strut\" style=\"height:0.6444em;\"></span><span class=\"mord\">0.928</span></span></span></span>; one more pass-through brings it to 0.896.</li>\n<li>Bresenham from <span class=\"katex\"><span class=\"katex-html\" aria-hidden=\"true\"><span class=\"katex-base\"><span class=\"katex-strut\" style=\"height:1em;vertical-align:-0.25em;\"></span><span class=\"mopen\">(</span><span class=\"mord\">0</span><span class=\"mpunct\">,</span><span class=\"mspace\" style=\"margin-right:0.1667em;\"></span><span class=\"mord\">0</span><span class=\"mclose\">)</span></span></span></span> to <span class=\"katex\"><span class=\"katex-html\" aria-hidden=\"true\"><span class=\"katex-base\"><span class=\"katex-strut\" style=\"height:1em;vertical-align:-0.25em;\"></span><span class=\"mopen\">(</span><span class=\"mord\">3</span><span class=\"mpunct\">,</span><span class=\"mspace\" style=\"margin-right:0.1667em;\"></span><span class=\"mord\">7</span><span class=\"mclose\">)</span></span></span></span> visits 8 cells.</li>\n<li>1 scan: 7.4 % of cells observed (a single free pass, <span class=\"katex\"><span class=\"katex-html\" aria-hidden=\"true\"><span class=\"katex-base\"><span class=\"katex-strut\" style=\"height:0.7278em;vertical-align:-0.0833em;\"></span><span class=\"mord\">−</span><span class=\"mord\">0.4</span></span></span></span>, is below the threshold), 96.2 % correct. 5 scans: 69.2 % observed, 98.8 % correct. 20 scans: 92.2 % observed, 98.3 % correct, with 99.7 % of observed wall cells marked occupied.</li>\n<li>All 245 misclassified cells after 20 scans are within 2 cells (10 cm) of a wall surface.</li>\n</ol>\n<h2 id=\"code-it-from-scratch\">Code it from scratch</h2>\n\n<div class=\"code-card\" data-code=\"0\"><div class=\"code-head\"><span class=\"fname\" translate=\"no\">occupancy_grid.py</span><button class=\"btn btn-quiet btn-small\" type=\"button\" data-copy=\"0\">Copy</button><button class=\"btn btn-quiet btn-small\" type=\"button\" data-download=\"0\">Download</button></div><pre tabindex=\"0\"><code class=\"language-python\"><span class=\"hljs-keyword\">import</span> numpy <span class=\"hljs-keyword\">as</span> np\n<span class=\"hljs-keyword\">from</span> scipy.ndimage <span class=\"hljs-keyword\">import</span> binary_dilation, binary_erosion\n\nRES = <span class=\"hljs-number\">0.05</span>                                                            <span class=\"hljs-comment\"># illustrative 5 cm cells</span>\nW, H = <span class=\"hljs-number\">160</span>, <span class=\"hljs-number\">100</span>                                                      <span class=\"hljs-comment\"># an 8 x 5 m area</span>\nL_OCC, L_FREE, L_MIN, L_MAX = <span class=\"hljs-number\">0.85</span>, -<span class=\"hljs-number\">0.4</span>, -<span class=\"hljs-number\">4.0</span>, <span class=\"hljs-number\">4.0</span>                   <span class=\"hljs-comment\"># inverse sensor model in log-odds, with clamping</span>\n\n<span class=\"hljs-keyword\">def</span> <span class=\"hljs-title function_\">true_map</span>():\n    <span class=\"hljs-string\">&quot;&quot;&quot;illustrative ground truth: outer walls, a pillar and a wall stub (True = occupied)&quot;&quot;&quot;</span>\n    g = np.zeros((H, W), <span class=\"hljs-built_in\">bool</span>); g[:<span class=\"hljs-number\">2</span>, :] = g[-<span class=\"hljs-number\">2</span>:, :] = <span class=\"hljs-literal\">True</span>; g[:, :<span class=\"hljs-number\">2</span>] = g[:, -<span class=\"hljs-number\">2</span>:] = <span class=\"hljs-literal\">True</span>\n    g[<span class=\"hljs-number\">30</span>:<span class=\"hljs-number\">50</span>, <span class=\"hljs-number\">100</span>:<span class=\"hljs-number\">120</span>] = <span class=\"hljs-literal\">True</span>; g[:<span class=\"hljs-number\">24</span>, <span class=\"hljs-number\">30</span>:<span class=\"hljs-number\">33</span>] = <span class=\"hljs-literal\">True</span>; g[<span class=\"hljs-number\">70</span>:, <span class=\"hljs-number\">60</span>:<span class=\"hljs-number\">63</span>] = <span class=\"hljs-literal\">True</span>\n    <span class=\"hljs-keyword\">return</span> g\n\n<span class=\"hljs-keyword\">def</span> <span class=\"hljs-title function_\">cast</span>(<span class=\"hljs-params\">grid, x, y, ang, max_range=<span class=\"hljs-number\">6.0</span></span>):\n    <span class=\"hljs-string\">&quot;&quot;&quot;march along a beam in quarter-cell steps until it hits an occupied cell (a simple stand-in for a real laser)&quot;&quot;&quot;</span>\n    <span class=\"hljs-keyword\">for</span> r <span class=\"hljs-keyword\">in</span> np.arange(<span class=\"hljs-number\">0</span>, max_range, RES / <span class=\"hljs-number\">4</span>):\n        i, j = <span class=\"hljs-built_in\">int</span>((y + r * np.sin(ang)) / RES), <span class=\"hljs-built_in\">int</span>((x + r * np.cos(ang)) / RES)\n        <span class=\"hljs-keyword\">if</span> <span class=\"hljs-keyword\">not</span> (<span class=\"hljs-number\">0</span> &lt;= i &lt; H <span class=\"hljs-keyword\">and</span> <span class=\"hljs-number\">0</span> &lt;= j &lt; W): <span class=\"hljs-keyword\">return</span> r, <span class=\"hljs-literal\">False</span>\n        <span class=\"hljs-keyword\">if</span> grid[i, j]: <span class=\"hljs-keyword\">return</span> r, <span class=\"hljs-literal\">True</span>\n    <span class=\"hljs-keyword\">return</span> max_range, <span class=\"hljs-literal\">False</span>\n\n<span class=\"hljs-keyword\">def</span> <span class=\"hljs-title function_\">bresenham</span>(<span class=\"hljs-params\">i0, j0, i1, j1</span>):\n    <span class=\"hljs-string\">&quot;&quot;&quot;the cells on the line from (i0, j0) to (i1, j1), integer arithmetic only&quot;&quot;&quot;</span>\n    cells = []; di, dj = <span class=\"hljs-built_in\">abs</span>(i1 - i0), <span class=\"hljs-built_in\">abs</span>(j1 - j0); si, sj = (<span class=\"hljs-number\">1</span> <span class=\"hljs-keyword\">if</span> i1 &gt; i0 <span class=\"hljs-keyword\">else</span> -<span class=\"hljs-number\">1</span>), (<span class=\"hljs-number\">1</span> <span class=\"hljs-keyword\">if</span> j1 &gt; j0 <span class=\"hljs-keyword\">else</span> -<span class=\"hljs-number\">1</span>); err = dj - di\n    <span class=\"hljs-keyword\">while</span> <span class=\"hljs-literal\">True</span>:\n        cells.append((i0, j0))\n        <span class=\"hljs-keyword\">if</span> (i0, j0) == (i1, j1): <span class=\"hljs-keyword\">return</span> cells\n        e2 = <span class=\"hljs-number\">2</span> * err\n        <span class=\"hljs-keyword\">if</span> e2 &gt; -di: err -= di; j0 += sj\n        <span class=\"hljs-keyword\">if</span> e2 &lt; dj: err += dj; i0 += si\n\n<span class=\"hljs-keyword\">def</span> <span class=\"hljs-title function_\">integrate</span>(<span class=\"hljs-params\">L, x, y, th, ranges, angles, hits</span>):\n    <span class=\"hljs-string\">&quot;&quot;&quot;log-odds update: cells the beam passes through become more likely free, the end cell more likely occupied&quot;&quot;&quot;</span>\n    i0, j0 = <span class=\"hljs-built_in\">int</span>(y / RES), <span class=\"hljs-built_in\">int</span>(x / RES)\n    <span class=\"hljs-keyword\">for</span> r, a, hit <span class=\"hljs-keyword\">in</span> <span class=\"hljs-built_in\">zip</span>(ranges, angles, hits):\n        ex, ey = x + r * np.cos(th + a), y + r * np.sin(th + a)\n        i1, j1 = <span class=\"hljs-built_in\">min</span>(<span class=\"hljs-built_in\">max</span>(<span class=\"hljs-built_in\">int</span>(ey / RES), <span class=\"hljs-number\">0</span>), H - <span class=\"hljs-number\">1</span>), <span class=\"hljs-built_in\">min</span>(<span class=\"hljs-built_in\">max</span>(<span class=\"hljs-built_in\">int</span>(ex / RES), <span class=\"hljs-number\">0</span>), W - <span class=\"hljs-number\">1</span>)\n        cells = bresenham(i0, j0, i1, j1)\n        <span class=\"hljs-keyword\">for</span> i, j <span class=\"hljs-keyword\">in</span> cells[:-<span class=\"hljs-number\">1</span>]: L[i, j] += L_FREE\n        <span class=\"hljs-keyword\">if</span> hit: L[i1, j1] += L_OCC\n        <span class=\"hljs-keyword\">else</span>: L[i1, j1] += L_FREE\n    np.clip(L, L_MIN, L_MAX, out=L)\n\n<span class=\"hljs-keyword\">def</span> <span class=\"hljs-title function_\">prob</span>(<span class=\"hljs-params\">L</span>): <span class=\"hljs-keyword\">return</span> <span class=\"hljs-number\">1</span> - <span class=\"hljs-number\">1</span> / (<span class=\"hljs-number\">1</span> + np.exp(L))\n\n<span class=\"hljs-keyword\">def</span> <span class=\"hljs-title function_\">build</span>(<span class=\"hljs-params\">n_scans, noise=<span class=\"hljs-number\">0.02</span>, seed=<span class=\"hljs-number\">0</span></span>):\n    rng = np.random.default_rng(seed); g = true_map(); L = np.zeros((H, W))\n    path = [(<span class=\"hljs-number\">0.8</span> + <span class=\"hljs-number\">6.4</span> * t, <span class=\"hljs-number\">2.5</span> - <span class=\"hljs-number\">0.8</span> * np.sin(<span class=\"hljs-number\">2</span> * np.pi * t), <span class=\"hljs-number\">0.3</span> * t) <span class=\"hljs-keyword\">for</span> t <span class=\"hljs-keyword\">in</span> np.linspace(<span class=\"hljs-number\">0</span>, <span class=\"hljs-number\">1</span>, n_scans)]\n    angles = np.radians(np.arange(<span class=\"hljs-number\">0</span>, <span class=\"hljs-number\">360</span>, <span class=\"hljs-number\">2</span>))\n    <span class=\"hljs-keyword\">for</span> x, y, th <span class=\"hljs-keyword\">in</span> path:\n        rh = [cast(g, x, y, th + a) <span class=\"hljs-keyword\">for</span> a <span class=\"hljs-keyword\">in</span> angles]\n        ranges = np.array([r <span class=\"hljs-keyword\">for</span> r, _ <span class=\"hljs-keyword\">in</span> rh]) + rng.normal(<span class=\"hljs-number\">0</span>, noise, <span class=\"hljs-built_in\">len</span>(angles))\n        integrate(L, x, y, th, ranges, angles, [h <span class=\"hljs-keyword\">for</span> _, h <span class=\"hljs-keyword\">in</span> rh])\n    <span class=\"hljs-keyword\">return</span> L, g\n\n<span class=\"hljs-keyword\">def</span> <span class=\"hljs-title function_\">score</span>(<span class=\"hljs-params\">L, g</span>):\n    known = np.<span class=\"hljs-built_in\">abs</span>(L) &gt; <span class=\"hljs-number\">0.5</span>; p = prob(L)\n    agree = ((p &gt; <span class=\"hljs-number\">0.5</span>) == g)[known].mean(); occ_recall = (g &amp; known &amp; (p &gt; <span class=\"hljs-number\">0.5</span>)).<span class=\"hljs-built_in\">sum</span>() / (g &amp; known).<span class=\"hljs-built_in\">sum</span>()\n    <span class=\"hljs-keyword\">return</span> known.mean(), agree, occ_recall\n\n<span class=\"hljs-keyword\">def</span> <span class=\"hljs-title function_\">test_log_odds</span>():\n    l = <span class=\"hljs-number\">0.0</span>\n    <span class=\"hljs-keyword\">for</span> _ <span class=\"hljs-keyword\">in</span> <span class=\"hljs-built_in\">range</span>(<span class=\"hljs-number\">3</span>): l += L_OCC\n    <span class=\"hljs-built_in\">print</span>(<span class=\"hljs-string\">f&quot;three hits on a cell: log-odds <span class=\"hljs-subst\">{l:<span class=\"hljs-number\">.2</span>f}</span>, probability <span class=\"hljs-subst\">{prob(np.array(l)):<span class=\"hljs-number\">.3</span>f}</span>; one more miss: <span class=\"hljs-subst\">{prob(np.array(l + L_FREE)):<span class=\"hljs-number\">.3</span>f}</span>&quot;</span>)\n    <span class=\"hljs-keyword\">assert</span> <span class=\"hljs-built_in\">abs</span>(prob(np.array(<span class=\"hljs-number\">0.0</span>)) - <span class=\"hljs-number\">0.5</span>) &lt; <span class=\"hljs-number\">1e-12</span> <span class=\"hljs-keyword\">and</span> prob(np.array(l)) &gt; <span class=\"hljs-number\">0.9</span>\n\n<span class=\"hljs-keyword\">def</span> <span class=\"hljs-title function_\">test_bresenham</span>():\n    c = bresenham(<span class=\"hljs-number\">0</span>, <span class=\"hljs-number\">0</span>, <span class=\"hljs-number\">3</span>, <span class=\"hljs-number\">7</span>)\n    <span class=\"hljs-built_in\">print</span>(<span class=\"hljs-string\">f&quot;cells from (0, 0) to (3, 7): <span class=\"hljs-subst\">{c}</span>&quot;</span>)\n    <span class=\"hljs-keyword\">assert</span> c[<span class=\"hljs-number\">0</span>] == (<span class=\"hljs-number\">0</span>, <span class=\"hljs-number\">0</span>) <span class=\"hljs-keyword\">and</span> c[-<span class=\"hljs-number\">1</span>] == (<span class=\"hljs-number\">3</span>, <span class=\"hljs-number\">7</span>) <span class=\"hljs-keyword\">and</span> <span class=\"hljs-built_in\">len</span>(c) == <span class=\"hljs-number\">8</span>\n\n<span class=\"hljs-keyword\">def</span> <span class=\"hljs-title function_\">test_map_matches_truth</span>():\n    <span class=\"hljs-keyword\">for</span> n <span class=\"hljs-keyword\">in</span> (<span class=\"hljs-number\">1</span>, <span class=\"hljs-number\">5</span>, <span class=\"hljs-number\">20</span>):\n        L, g = build(n); seen, agree, rec = score(L, g)\n        <span class=\"hljs-built_in\">print</span>(<span class=\"hljs-string\">f&quot;<span class=\"hljs-subst\">{n:2d}</span> scans: <span class=\"hljs-subst\">{<span class=\"hljs-number\">100</span> * seen:<span class=\"hljs-number\">.1</span>f}</span> % of cells observed, <span class=\"hljs-subst\">{<span class=\"hljs-number\">100</span> * agree:<span class=\"hljs-number\">.1</span>f}</span> % of observed cells classified correctly, &quot;</span>\n              <span class=\"hljs-string\">f&quot;<span class=\"hljs-subst\">{<span class=\"hljs-number\">100</span> * rec:<span class=\"hljs-number\">.1</span>f}</span> % of observed wall cells marked occupied&quot;</span>)\n    <span class=\"hljs-keyword\">assert</span> agree &gt; <span class=\"hljs-number\">0.95</span> <span class=\"hljs-keyword\">and</span> seen &gt; <span class=\"hljs-number\">0.6</span>\n    wrong = (np.<span class=\"hljs-built_in\">abs</span>(L) &gt; <span class=\"hljs-number\">0.5</span>) &amp; ((prob(L) &gt; <span class=\"hljs-number\">0.5</span>) != g); surface = g &amp; ~binary_erosion(g)\n    near = binary_dilation(surface, iterations=<span class=\"hljs-number\">2</span>)\n    <span class=\"hljs-built_in\">print</span>(<span class=\"hljs-string\">f&quot;all <span class=\"hljs-subst\">{wrong.<span class=\"hljs-built_in\">sum</span>()}</span> misclassified cells within 2 cells (10 cm) of a wall surface: <span class=\"hljs-subst\">{<span class=\"hljs-built_in\">bool</span>((wrong &lt;= near).<span class=\"hljs-built_in\">all</span>())}</span>&quot;</span>)\n    <span class=\"hljs-keyword\">assert</span> (wrong &lt;= near).<span class=\"hljs-built_in\">all</span>()\n\ntest_log_odds()\ntest_bresenham()\ntest_map_matches_truth()\n<span class=\"hljs-built_in\">print</span>(<span class=\"hljs-string\">&quot;PASS&quot;</span>)</code></pre></div>\n<h2 id=\"in-practice\">In practice</h2>\n<p>Nav2 plans on occupancy grids (<code>nav_msgs/OccupancyGrid</code>, values 0 to 100 and -1 for unknown), saved as an image plus YAML by <code>map_saver</code>. The map is usually built once with a SLAM package (slam_toolbox), then AMCL (lesson 15) localises in it. Costmaps layer obstacles seen live on top.</p>\n<h2 id=\"exercises\">Exercises</h2>\n\n<div class=\"exercise\"><div class=\"ex-q\"><p>How many consistent hits are needed to take an unknown cell above <span class=\"katex\"><span class=\"katex-html\" aria-hidden=\"true\"><span class=\"katex-base\"><span class=\"katex-strut\" style=\"height:0.625em;vertical-align:-0.1944em;\"></span><span class=\"mord mathnormal\">p</span><span class=\"mspace\" style=\"margin-right:0.2778em;\"></span><span class=\"mrel\">=</span><span class=\"mspace\" style=\"margin-right:0.2778em;\"></span></span><span class=\"katex-base\"><span class=\"katex-strut\" style=\"height:0.6444em;\"></span><span class=\"mord\">0.95</span></span></span></span> with <span class=\"katex\"><span class=\"katex-html\" aria-hidden=\"true\"><span class=\"katex-base\"><span class=\"katex-strut\" style=\"height:0.7278em;vertical-align:-0.0833em;\"></span><span class=\"mord\">+</span><span class=\"mord\">0.85</span></span></span></span> per hit?</p>\n</div><details><summary>Show the solution</summary><div class=\"ex-s\"><p><span class=\"katex\"><span class=\"katex-html\" aria-hidden=\"true\"><span class=\"katex-base\"><span class=\"katex-strut\" style=\"height:0.6944em;\"></span><span class=\"mord\">ℓ</span><span class=\"mspace\" style=\"margin-right:0.2778em;\"></span><span class=\"mrel\">=</span><span class=\"mspace\" style=\"margin-right:0.2778em;\"></span></span><span class=\"katex-base\"><span class=\"katex-strut\" style=\"height:1em;vertical-align:-0.25em;\"></span><span class=\"mop\">lo<span style=\"margin-right:0.0139em;\">g</span></span><span class=\"mopen\">(</span><span class=\"mord\">0.95/0.05</span><span class=\"mclose\">)</span><span class=\"mspace\" style=\"margin-right:0.2778em;\"></span><span class=\"mrel\">=</span><span class=\"mspace\" style=\"margin-right:0.2778em;\"></span></span><span class=\"katex-base\"><span class=\"katex-strut\" style=\"height:0.6444em;\"></span><span class=\"mord\">2.94</span></span></span></span>, so <span class=\"katex\"><span class=\"katex-html\" aria-hidden=\"true\"><span class=\"katex-base\"><span class=\"katex-strut\" style=\"height:1em;vertical-align:-0.25em;\"></span><span class=\"mord\">2.94/0.85</span><span class=\"mspace\" style=\"margin-right:0.2778em;\"></span><span class=\"mrel\">=</span><span class=\"mspace\" style=\"margin-right:0.2778em;\"></span></span><span class=\"katex-base\"><span class=\"katex-strut\" style=\"height:0.6444em;\"></span><span class=\"mord\">3.5</span></span></span></span>: four hits.</p>\n</div></details></div>\n\n<div class=\"exercise\"><div class=\"ex-q\"><p>Why not just set a cell to “occupied” whenever a beam ends in it?</p>\n</div><details><summary>Show the solution</summary><div class=\"ex-s\"><p>A single spurious reading (a person walking past, a reflection) would mark it forever. Adding evidence lets later free observations overturn it, and clamping makes sure that is always possible.</p>\n</div></details></div>\n<h2 id=\"quiz\">Quiz</h2>\n\n<div class=\"quiz\" data-quiz=\"p17-l17\"></div>\n","toc":[{"id":"grids-and-log-odds","title":"Grids and log-odds"},{"id":"tracing-the-beams","title":"Tracing the beams"},{"id":"what-the-map-gets-wrong","title":"What the map gets wrong"},{"id":"worked-example","title":"Worked example"},{"id":"code-it-from-scratch","title":"Code it from scratch"},{"id":"in-practice","title":"In practice"},{"id":"exercises","title":"Exercises"},{"id":"quiz","title":"Quiz"}],"quiz":[{"id":"p17-l17-q1","type":"num","q":"<p>Probability of a cell with log-odds 2?</p>\n","explain":"<p>1 - 1/(1 + e^2).</p>\n","answer":0.8808,"tol":0.002,"unit":""},{"id":"p17-l17-q2","type":"num","q":"<p>Log-odds after two hits (+0.85 each) and one pass-through (-0.4)?</p>\n","explain":"<p>Updates add.</p>\n","answer":1.3,"tol":0.002,"unit":""},{"id":"p17-l17-q3","type":"num","q":"<p>Cells in a 20 × 20 m map at 5 cm resolution?</p>\n","explain":"<p>400 cells per side.</p>\n","answer":160000,"tol":0.001,"unit":""},{"id":"p17-l17-q4","type":"num","q":"<p>Log-odds of p = 0.5?</p>\n","explain":"<p>log(1) = 0, unknown.</p>\n","answer":0,"tol":0.001,"unit":""},{"id":"p17-l17-q5","type":"mc","q":"<p>Log-odds clamping is used so that…</p>\n","explain":"<p>Without it, long-observed cells could never flip.</p>\n","options":["Bresenham’s algorithm works","beams can pass through walls","the map can still change when the world changes","the map uses less memory"],"answer":2},{"id":"p17-l17-q6","type":"mc","q":"<p>Occupancy grid mapping as presented here assumes…</p>\n","explain":"<p>Mapping with known poses; SLAM drops that assumption.</p>\n","options":["the robot’s poses are known","only one scan","the map is known","the laser has no noise"],"answer":0}],"code":[{"file":"occupancy_grid.py","lang":"python","src":"import numpy as np\nfrom scipy.ndimage import binary_dilation, binary_erosion\n\nRES = 0.05                                                            # illustrative 5 cm cells\nW, H = 160, 100                                                      # an 8 x 5 m area\nL_OCC, L_FREE, L_MIN, L_MAX = 0.85, -0.4, -4.0, 4.0                   # inverse sensor model in log-odds, with clamping\n\ndef true_map():\n    \"\"\"illustrative ground truth: outer walls, a pillar and a wall stub (True = occupied)\"\"\"\n    g = np.zeros((H, W), bool); g[:2, :] = g[-2:, :] = True; g[:, :2] = g[:, -2:] = True\n    g[30:50, 100:120] = True; g[:24, 30:33] = True; g[70:, 60:63] = True\n    return g\n\ndef cast(grid, x, y, ang, max_range=6.0):\n    \"\"\"march along a beam in quarter-cell steps until it hits an occupied cell (a simple stand-in for a real laser)\"\"\"\n    for r in np.arange(0, max_range, RES / 4):\n        i, j = int((y + r * np.sin(ang)) / RES), int((x + r * np.cos(ang)) / RES)\n        if not (0 <= i < H and 0 <= j < W): return r, False\n        if grid[i, j]: return r, True\n    return max_range, False\n\ndef bresenham(i0, j0, i1, j1):\n    \"\"\"the cells on the line from (i0, j0) to (i1, j1), integer arithmetic only\"\"\"\n    cells = []; di, dj = abs(i1 - i0), abs(j1 - j0); si, sj = (1 if i1 > i0 else -1), (1 if j1 > j0 else -1); err = dj - di\n    while True:\n        cells.append((i0, j0))\n        if (i0, j0) == (i1, j1): return cells\n        e2 = 2 * err\n        if e2 > -di: err -= di; j0 += sj\n        if e2 < dj: err += dj; i0 += si\n\ndef integrate(L, x, y, th, ranges, angles, hits):\n    \"\"\"log-odds update: cells the beam passes through become more likely free, the end cell more likely occupied\"\"\"\n    i0, j0 = int(y / RES), int(x / RES)\n    for r, a, hit in zip(ranges, angles, hits):\n        ex, ey = x + r * np.cos(th + a), y + r * np.sin(th + a)\n        i1, j1 = min(max(int(ey / RES), 0), H - 1), min(max(int(ex / RES), 0), W - 1)\n        cells = bresenham(i0, j0, i1, j1)\n        for i, j in cells[:-1]: L[i, j] += L_FREE\n        if hit: L[i1, j1] += L_OCC\n        else: L[i1, j1] += L_FREE\n    np.clip(L, L_MIN, L_MAX, out=L)\n\ndef prob(L): return 1 - 1 / (1 + np.exp(L))\n\ndef build(n_scans, noise=0.02, seed=0):\n    rng = np.random.default_rng(seed); g = true_map(); L = np.zeros((H, W))\n    path = [(0.8 + 6.4 * t, 2.5 - 0.8 * np.sin(2 * np.pi * t), 0.3 * t) for t in np.linspace(0, 1, n_scans)]\n    angles = np.radians(np.arange(0, 360, 2))\n    for x, y, th in path:\n        rh = [cast(g, x, y, th + a) for a in angles]\n        ranges = np.array([r for r, _ in rh]) + rng.normal(0, noise, len(angles))\n        integrate(L, x, y, th, ranges, angles, [h for _, h in rh])\n    return L, g\n\ndef score(L, g):\n    known = np.abs(L) > 0.5; p = prob(L)\n    agree = ((p > 0.5) == g)[known].mean(); occ_recall = (g & known & (p > 0.5)).sum() / (g & known).sum()\n    return known.mean(), agree, occ_recall\n\ndef test_log_odds():\n    l = 0.0\n    for _ in range(3): l += L_OCC\n    print(f\"three hits on a cell: log-odds {l:.2f}, probability {prob(np.array(l)):.3f}; one more miss: {prob(np.array(l + L_FREE)):.3f}\")\n    assert abs(prob(np.array(0.0)) - 0.5) < 1e-12 and prob(np.array(l)) > 0.9\n\ndef test_bresenham():\n    c = bresenham(0, 0, 3, 7)\n    print(f\"cells from (0, 0) to (3, 7): {c}\")\n    assert c[0] == (0, 0) and c[-1] == (3, 7) and len(c) == 8\n\ndef test_map_matches_truth():\n    for n in (1, 5, 20):\n        L, g = build(n); seen, agree, rec = score(L, g)\n        print(f\"{n:2d} scans: {100 * seen:.1f} % of cells observed, {100 * agree:.1f} % of observed cells classified correctly, \"\n              f\"{100 * rec:.1f} % of observed wall cells marked occupied\")\n    assert agree > 0.95 and seen > 0.6\n    wrong = (np.abs(L) > 0.5) & ((prob(L) > 0.5) != g); surface = g & ~binary_erosion(g)\n    near = binary_dilation(surface, iterations=2)\n    print(f\"all {wrong.sum()} misclassified cells within 2 cells (10 cm) of a wall surface: {bool((wrong <= near).all())}\")\n    assert (wrong <= near).all()\n\ntest_log_odds()\ntest_bresenham()\ntest_map_matches_truth()\nprint(\"PASS\")"}]}