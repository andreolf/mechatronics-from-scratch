Q</span><span class=\"mspace\" style=\"margin-right:0.2778em;\"></span><span class=\"mrel\">=</span><span class=\"mspace\" style=\"margin-right:0.2778em;\"></span></span><span class=\"katex-base\"><span class=\"katex-strut\" style=\"height:0.7278em;vertical-align:-0.0833em;\"></span><span class=\"mord\">0.61</span><span class=\"mspace\" style=\"margin-right:0.2222em;\"></span><span class=\"mbin\">×</span><span class=\"mspace\" style=\"margin-right:0.2222em;\"></span></span><span class=\"katex-base\"><span class=\"katex-strut\" style=\"height:0.7278em;vertical-align:-0.0833em;\"></span><span class=\"mord\">7.854</span><span class=\"mspace\" style=\"margin-right:0.2222em;\"></span><span class=\"mbin\">×</span><span class=\"mspace\" style=\"margin-right:0.2222em;\"></span></span><span class=\"katex-base\"><span class=\"katex-strut\" style=\"height:0.8974em;vertical-align:-0.0833em;\"></span><span class=\"mord\">1</span><span class=\"mord\"><span class=\"mord\">0</span><span class=\"msupsub\"><span class=\"vlist-t\"><span class=\"vlist-r\"><span class=\"vlist\" style=\"height:0.8141em;\"><span style=\"top:-3.063em;margin-right:0.05em;\"><span class=\"pstrut\" style=\"height:2.7em;\"></span><span class=\"katex-sizing reset-size6 size3 mtight\"><span class=\"mord mtight\"><span class=\"mord mtight\">−</span><span class=\"mord mtight\">5</span></span></span></span></span></span></span></span></span><span class=\"mspace\" style=\"margin-right:0.2222em;\"></span><span class=\"mbin\">×</span><span class=\"mspace\" style=\"margin-right:0.2222em;\"></span></span><span class=\"katex-base\"><span class=\"katex-strut\" style=\"height:1.24em;vertical-align:-0.305em;\"></span><span class=\"mord sqrt\"><span class=\"vlist-t vlist-t2\"><span class=\"vlist-r\"><span class=\"vlist\" style=\"height:0.935em;\"><span class=\"svg-align\" style=\"top:-3.2em;\"><span class=\"pstrut\" style=\"height:3.2em;\"></span><span class=\"mord\" style=\"padding-left:1em;\"><span class=\"mord\">2</span><span class=\"mspace\" style=\"margin-right:0.2222em;\"></span><span class=\"mbin\">×</span><span class=\"mspace\" style=\"margin-right:0.2222em;\"></span><span class=\"mord\">2000/1.204</span></span></span><span style=\"top:-2.895em;\"><span class=\"pstrut\" style=\"height:3.2em;\"></span><span class=\"hide-tail\" style=\"min-width:1.02em;height:1.28em;\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"400em\" height=\"1.28em\" viewBox=\"0 0 400000 1296\" preserveAspectRatio=\"xMinYMin slice\"><path d=\"M263,681c0.7,0,18,39.7,52,119\nc34,79.3,68.167,158.7,102.5,238c34.3,79.3,51.8,119.3,52.5,120\nc340,-704.7,510.7,-1060.3,512,-1067\nl0 -0\nc4.7,-7.3,11,-11,19,-11\nH40000v40H1012.3\ns-271.3,567,-271.3,567c-38.7,80.7,-84,175,-136,283c-52,108,-89.167,185.3,-111.5,232\nc-22.3,46.7,-33.8,70.3,-34.5,71c-4.7,4.7,-12.3,7,-23,7s-12,-1,-12,-1\ns-109,-253,-109,-253c-72.7,-168,-109.3,-252,-110,-252c-10.7,8,-22,16.7,-34,26\nc-22,17.3,-33.3,26,-34,26s-26,-26,-26,-26s76,-59,76,-59s76,-60,76,-60z\nM1001 80h400000v40h-400000z\"/></svg></span></span></span><span class=\"vlist-s\">​</span></span><span class=\"vlist-r\"><span class=\"vlist\" style=\"height:0.305em;\"><span></span></span></span></span></span><span class=\"mspace\" style=\"margin-right:0.2778em;\"></span><span class=\"mrel\">=</span><span class=\"mspace\" style=\"margin-right:0.2778em;\"></span></span><span class=\"katex-base\"><span class=\"katex-strut\" style=\"height:0.7278em;vertical-align:-0.0833em;\"></span><span class=\"mord\">2.76</span><span class=\"mspace\" style=\"margin-right:0.2222em;\"></span><span class=\"mbin\">×</span><span class=\"mspace\" style=\"margin-right:0.2222em;\"></span></span><span class=\"katex-base\"><span class=\"katex-strut\" style=\"height:0.8141em;\"></span><span class=\"mord\">1</span><span class=\"mord\"><span class=\"mord\">0</span><span class=\"msupsub\"><span class=\"vlist-t\"><span class=\"vlist-r\"><span class=\"vlist\" style=\"height:0.8141em;\"><span style=\"top:-3.063em;margin-right:0.05em;\"><span class=\"pstrut\" style=\"height:2.7em;\"></span><span class=\"katex-sizing reset-size6 size3 mtight\"><span class=\"mord mtight\"><span class=\"mord mtight\">−</span><span class=\"mord mtight\">3</span></span></span></span></span></span></span></span></span></span></span></span> m³/s, which is 2.76 L/s.</li>\n<li>A sensor offset of 12.5 Pa (0.25 % of a 5 kPa range) at <span class=\"katex\"><span class=\"katex-html\" aria-hidden=\"true\"><span class=\"katex-base\"><span class=\"katex-strut\" style=\"height:0.8778em;vertical-align:-0.1944em;\"></span><span class=\"mord\">Δ</span><span class=\"mord mathnormal\">p</span><span class=\"mspace\" style=\"margin-right:0.2778em;\"></span><span class=\"mrel\">=</span><span class=\"mspace\" style=\"margin-right:0.2778em;\"></span></span><span class=\"katex-base\"><span class=\"katex-strut\" style=\"height:0.6444em;\"></span><span class=\"mord\">50</span></span></span></span> Pa gives <span class=\"katex\"><span class=\"katex-html\" aria-hidden=\"true\"><span class=\"katex-base\"><span class=\"katex-strut\" style=\"height:1.24em;vertical-align:-0.305em;\"></span><span class=\"mord sqrt\"><span class=\"vlist-t vlist-t2\"><span class=\"vlist-r\"><span class=\"vlist\" style=\"height:0.935em;\"><span class=\"svg-align\" style=\"top:-3.2em;\"><span class=\"pstrut\" style=\"height:3.2em;\"></span><span class=\"mord\" style=\"padding-left:1em;\"><span class=\"mord\">62.5/50</span></span></span><span style=\"top:-2.895em;\"><span class=\"pstrut\" style=\"height:3.2em;\"></span><span class=\"hide-tail\" style=\"min-width:1.02em;height:1.28em;\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"400em\" height=\"1.28em\" viewBox=\"0 0 400000 1296\" preserveAspectRatio=\"xMinYMin slice\"><path d=\"M263,681c0.7,0,18,39.7,52,119\nc34,79.3,68.167,158.7,102.5,238c34.3,79.3,51.8,119.3,52.5,120\nc340,-704.7,510.7,-1060.3,512,-1067\nl0 -0\nc4.7,-7.3,11,-11,19,-11\nH40000v40H1012.3\ns-271.3,567,-271.3,567c-38.7,80.7,-84,175,-136,283c-52,108,-89.167,185.3,-111.5,232\nc-22.3,46.7,-33.8,70.3,-34.5,71c-4.7,4.7,-12.3,7,-23,7s-12,-1,-12,-1\ns-109,-253,-109,-253c-72.7,-168,-109.3,-252,-110,-252c-10.7,8,-22,16.7,-34,26\nc-22,17.3,-33.3,26,-34,26s-26,-26,-26,-26s76,-59,76,-59s76,-60,76,-60z\nM1001 80h400000v40h-400000z\"/></svg></span></span></span><span class=\"vlist-s\">​</span></span><span class=\"vlist-r\"><span class=\"vlist\" style=\"height:0.305em;\"><span></span></span></span></span></span><span class=\"mspace\" style=\"margin-right:0.2778em;\"></span><span class=\"mrel\">=</span><span class=\"mspace\" style=\"margin-right:0.2778em;\"></span></span><span class=\"katex-base\"><span class=\"katex-strut\" style=\"height:0.6444em;\"></span><span class=\"mord\">1.118</span></span></span></span>: an 11.8 % flow error. At 2000 Pa it’s only 0.3 %.</li>\n</ol>\n<h2 id=\"code-it-from-scratch\">Code it from scratch</h2>\n\n<div class=\"code-card\" data-code=\"0\"><div class=\"code-head\"><span class=\"fname\" translate=\"no\">orifice.py</span><button class=\"btn btn-quiet btn-small\" type=\"button\" data-copy=\"0\">Copy</button><button class=\"btn btn-quiet btn-small\" type=\"button\" data-download=\"0\">Download</button></div><pre tabindex=\"0\"><code class=\"language-python\"><span class=\"hljs-keyword\">import</span> numpy <span class=\"hljs-keyword\">as</span> np\n\nrng = np.random.default_rng(<span class=\"hljs-number\">15</span>)\nCD, D, RS = <span class=\"hljs-number\">0.61</span>, <span class=\"hljs-number\">0.010</span>, <span class=\"hljs-number\">287.0</span>\nA = np.pi * D**<span class=\"hljs-number\">2</span> / <span class=\"hljs-number\">4</span>\n\n<span class=\"hljs-keyword\">def</span> <span class=\"hljs-title function_\">rho_air</span>(<span class=\"hljs-params\">p_abs=<span class=\"hljs-number\">101_300.0</span>, T_c=<span class=\"hljs-number\">20.0</span></span>):\n    <span class=\"hljs-keyword\">return</span> p_abs / (RS * (T_c + <span class=\"hljs-number\">273.15</span>))\n\n<span class=\"hljs-keyword\">def</span> <span class=\"hljs-title function_\">flow</span>(<span class=\"hljs-params\">dp, rho</span>):\n    <span class=\"hljs-keyword\">return</span> CD * A * np.sqrt(<span class=\"hljs-number\">2</span> * np.maximum(dp, <span class=\"hljs-number\">0</span>) / rho)\n\n<span class=\"hljs-keyword\">class</span> <span class=\"hljs-title class_\">DpSensor</span>:\n    <span class=\"hljs-string\">&quot;&quot;&quot;0-5 kPa differential sensor: 12-bit, 0.25 % FS offset, 0.05 % FS noise.&quot;&quot;&quot;</span>\n    <span class=\"hljs-keyword\">def</span> <span class=\"hljs-title function_\">__init__</span>(<span class=\"hljs-params\">self</span>):\n        <span class=\"hljs-variable language_\">self</span>.offset, <span class=\"hljs-variable language_\">self</span>.zero = <span class=\"hljs-number\">12.5</span>, <span class=\"hljs-number\">0.0</span>\n    <span class=\"hljs-keyword\">def</span> <span class=\"hljs-title function_\">read</span>(<span class=\"hljs-params\">self, dp, n=<span class=\"hljs-number\">16</span></span>):\n        raw = dp + <span class=\"hljs-variable language_\">self</span>.offset + <span class=\"hljs-number\">2.5</span> * rng.standard_normal(n)\n        <span class=\"hljs-keyword\">return</span> <span class=\"hljs-built_in\">float</span>(np.mean(np.<span class=\"hljs-built_in\">round</span>(raw / (<span class=\"hljs-number\">5000</span> / <span class=\"hljs-number\">4096</span>)) * (<span class=\"hljs-number\">5000</span> / <span class=\"hljs-number\">4096</span>))) - <span class=\"hljs-variable language_\">self</span>.zero\n    <span class=\"hljs-keyword\">def</span> <span class=\"hljs-title function_\">calibrate_zero</span>(<span class=\"hljs-params\">self</span>):\n        <span class=\"hljs-variable language_\">self</span>.zero = <span class=\"hljs-variable language_\">self</span>.read(<span class=\"hljs-number\">0.0</span>, n=<span class=\"hljs-number\">256</span>)\n\n<span class=\"hljs-keyword\">if</span> __name__ == <span class=\"hljs-string\">&quot;__main__&quot;</span>:\n    rho = rho_air()\n    q = flow(<span class=\"hljs-number\">2000</span>, rho)\n    <span class=\"hljs-keyword\">assert</span> <span class=\"hljs-built_in\">abs</span>(rho - <span class=\"hljs-number\">1.204</span>) &lt; <span class=\"hljs-number\">0.001</span> <span class=\"hljs-keyword\">and</span> <span class=\"hljs-built_in\">abs</span>(q * <span class=\"hljs-number\">1000</span> - <span class=\"hljs-number\">2.76</span>) &lt; <span class=\"hljs-number\">0.01</span>\n    s = DpSensor()\n    q_full = flow(<span class=\"hljs-number\">5000</span>, rho)\n    <span class=\"hljs-keyword\">def</span> <span class=\"hljs-title function_\">worst_error</span>(<span class=\"hljs-params\">sensor</span>):\n        worst = <span class=\"hljs-number\">0.0</span>\n        <span class=\"hljs-keyword\">for</span> frac <span class=\"hljs-keyword\">in</span> np.linspace(<span class=\"hljs-number\">0.1</span>, <span class=\"hljs-number\">1.0</span>, <span class=\"hljs-number\">10</span>):              <span class=\"hljs-comment\"># 10-100 % of full flow</span>\n            q_true = frac * q_full\n            dp = (q_true / (CD * A)) ** <span class=\"hljs-number\">2</span> * rho / <span class=\"hljs-number\">2</span>\n            worst = <span class=\"hljs-built_in\">max</span>(worst, <span class=\"hljs-built_in\">abs</span>(flow(sensor.read(dp), rho) - q_true) / q_true)\n        <span class=\"hljs-keyword\">return</span> worst\n    before = worst_error(s)\n    s.calibrate_zero()\n    after = worst_error(s)\n    <span class=\"hljs-built_in\">print</span>(<span class=\"hljs-string\">f&quot;worst flow error over 10-100 % flow: <span class=\"hljs-subst\">{<span class=\"hljs-number\">100</span>*before:<span class=\"hljs-number\">.1</span>f}</span> % before zeroing, <span class=\"hljs-subst\">{<span class=\"hljs-number\">100</span>*after:<span class=\"hljs-number\">.2</span>f}</span> % after&quot;</span>)\n    <span class=\"hljs-keyword\">assert</span> before &gt; <span class=\"hljs-number\">0.05</span> <span class=\"hljs-keyword\">and</span> after &lt; <span class=\"hljs-number\">0.05</span>\n    <span class=\"hljs-comment\"># temperature: using 20 C density when the air is at 50 C</span>\n    err = flow(<span class=\"hljs-number\">2000</span>, rho_air(T_c=<span class=\"hljs-number\">20</span>)) / flow(<span class=\"hljs-number\">2000</span>, rho_air(T_c=<span class=\"hljs-number\">50</span>)) - <span class=\"hljs-number\">1</span>\n    <span class=\"hljs-keyword\">assert</span> <span class=\"hljs-built_in\">abs</span>(err - (np.sqrt(<span class=\"hljs-number\">293.15</span> / <span class=\"hljs-number\">323.15</span>) - <span class=\"hljs-number\">1</span>)) &lt; <span class=\"hljs-number\">1e-12</span>\n    <span class=\"hljs-built_in\">print</span>(<span class=\"hljs-string\">f&quot;density from the wrong temperature (20 vs 50 C): <span class=\"hljs-subst\">{<span class=\"hljs-number\">100</span>*err:<span class=\"hljs-number\">.1</span>f}</span> % flow error&quot;</span>)</code></pre></div>\n<h2 id=\"exercises\">Exercises</h2>\n\n<div class=\"exercise\"><div class=\"ex-q\"><p>A flow meter must cover 1 to 20 L/s. What range of differential pressure does that span?</p>\n</div><details><summary>Show the solution</summary><div class=\"ex-s\"><p><span class=\"katex\"><span class=\"katex-html\" aria-hidden=\"true\"><span class=\"katex-base\"><span class=\"katex-strut\" style=\"height:0.8778em;vertical-align:-0.1944em;\"></span><span class=\"mord\">Δ</span><span class=\"mord mathnormal\">p</span><span class=\"mspace\" style=\"margin-right:0.2778em;\"></span><span class=\"mrel\">∝</span><span class=\"mspace\" style=\"margin-right:0.2778em;\"></span></span><span class=\"katex-base\"><span class=\"katex-strut\" style=\"height:1.0085em;vertical-align:-0.1944em;\"></span><span class=\"mord\"><span class=\"mord mathnormal\">Q</span><span class=\"msupsub\"><span class=\"vlist-t\"><span class=\"vlist-r\"><span class=\"vlist\" style=\"height:0.8141em;\"><span style=\"top:-3.063em;margin-right:0.05em;\"><span class=\"pstrut\" style=\"height:2.7em;\"></span><span class=\"katex-sizing reset-size6 size3 mtight\"><span class=\"mord mtight\">2</span></span></span></span></span></span></span></span></span></span></span>, so 20:1 in flow is 400:1 in pressure. At the low end the signal is 0.25 % of the top-end pressure, which is why wide-range meters switch sensors or use other principles.</p>\n</div></details></div>\n\n<div class=\"exercise\"><div class=\"ex-q\"><p>Why report zero flow below a small threshold instead of the computed value?</p>\n</div><details><summary>Show the solution</summary><div class=\"ex-s\"><p>Near zero, noise and residual offset alternate between small positive and negative <span class=\"katex\"><span class=\"katex-html\" aria-hidden=\"true\"><span class=\"katex-base\"><span class=\"katex-strut\" style=\"height:0.8778em;vertical-align:-0.1944em;\"></span><span class=\"mord\">Δ</span><span class=\"mord mathnormal\">p</span></span></span></span>, and the square root turns them into large apparent flows. A cut-off at a few percent of full scale avoids reporting flow that isn’t there.</p>\n</div></details></div>\n<h2 id=\"quiz\">Quiz</h2>\n\n<div class=\"quiz\" data-quiz=\"p07-l15\"></div>\n\n","toc":[{"id":"pressure-sensors","title":"Pressure sensors"},{"id":"flow-from-a-pressure-drop","title":"Flow from a pressure drop"},{"id":"worked-example","title":"Worked example"},{"id":"code-it-from-scratch","title":"Code it from scratch"},{"id":"exercises","title":"Exercises"},{"id":"quiz","title":"Quiz"}],"quiz":[{"id":"p07-l15-q1","type":"num","q":"<p>Air density in kg/m³ at 20 °C and 101.3 kPa?</p>\n","explain":"<p>p/(R_s T).</p>\n","answer":1.2041,"tol":0.001,"unit":"kg/m³"},{"id":"p07-l15-q2","type":"num","q":"<p>Flow in L/s through a 10 mm orifice (C_d 0.61) at 2000 Pa, ρ = 1.204?</p>\n","explain":"<p>C_d A √(2Δp/ρ).</p>\n","answer":2.7604,"tol":0.003,"unit":"L/s"},{"id":"p07-l15-q3","type":"num","q":"<p>Pressure ratio needed for a 10:1 flow range?</p>\n","explain":"<p>Δp ∝ Q².</p>\n","answer":100,"tol":0.001,"unit":""},{"id":"p07-l15-q4","type":"num","q":"<p>Flow error in % from a 12.5 Pa offset at Δp = 50 Pa?</p>\n","explain":"<p>The square root amplifies it at low flow.</p>\n","answer":11.803,"tol":0.002,"unit":"%"},{"id":"p07-l15-q5","type":"mc","q":"<p>A differential pressure sensor measures…</p>\n","explain":"<p>Used for flow.</p>\n","options":["against vacuum","against ambient air","between two ports","temperature"],"answer":2},{"id":"p07-l15-q6","type":"mc","q":"<p>The discharge coefficient accounts for…</p>\n","explain":"<p>Real flow is less than ideal.</p>\n","options":["the jet contracting and losses","the sensor’s offset","temperature","ADC resolution"],"answer":0}],"code":[{"file":"orifice.py","lang":"python","src":"import numpy as np\n\nrng = np.random.default_rng(15)\nCD, D, RS = 0.61, 0.010, 287.0\nA = np.pi * D**2 / 4\n\ndef rho_air(p_abs=101_300.0, T_c=20.0):\n    return p_abs / (RS * (T_c + 273.15))\n\ndef flow(dp, rho):\n    return CD * A * np.sqrt(2 * np.maximum(dp, 0) / rho)\n\nclass DpSensor:\n    \"\"\"0-5 kPa differential sensor: 12-bit, 0.25 % FS offset, 0.05 % FS noise.\"\"\"\n    def __init__(self):\n        self.offset, self.zero = 12.5, 0.0\n    def read(self, dp, n=16):\n        raw = dp + self.offset + 2.5 * rng.standard_normal(n)\n        return float(np.mean(np.round(raw / (5000 / 4096)) * (5000 / 4096))) - self.zero\n    def calibrate_zero(self):\n        self.zero = self.read(0.0, n=256)\n\nif __name__ == \"__main__\":\n    rho = rho_air()\n    q = flow(2000, rho)\n    assert abs(rho - 1.204) < 0.001 and abs(q * 1000 - 2.76) < 0.01\n    s = DpSensor()\n    q_full = flow(5000, rho)\n    def worst_error(sensor):\n        worst = 0.0\n        for frac in np.linspace(0.1, 1.0, 10):              # 10-100 % of full flow\n            q_true = frac * q_full\n            dp = (q_true / (CD * A)) ** 2 * rho / 2\n            worst = max(worst, abs(flow(sensor.read(dp), rho) - q_true) / q_true)\n        return worst\n    before = worst_error(s)\n    s.calibrate_zero()\n    after = worst_error(s)\n    print(f\"worst flow error over 10-100 % flow: {100*before:.1f} % before zeroing, {100*after:.2f} % after\")\n    assert before > 0.05 and after < 0.05\n    # temperature: using 20 C density when the air is at 50 C\n    err = flow(2000, rho_air(T_c=20)) / flow(2000, rho_air(T_c=50)) - 1\n    assert abs(err - (np.sqrt(293.15 / 323.15) - 1)) < 1e-12\n    print(f\"density from the wrong temperature (20 vs 50 C): {100*err:.1f} % flow error\")"}]}